// @std/test: test cases and assertions for `cluau test`.
//
//   const test = require("@std/test")
//
//   test.case("adds", function() {
//   	test.equal(1 + 1, 2)
//   	test.equal({ x = 1, y = 2 }, { y = 2, x = 1 }) // tables compare by contents
//   	test.raises(function() { error("boom") }, "boom")
//   })
//
// Each case runs when it is declared; a failed assertion ends that case and
// the next one runs. `cluau test` runs every *_test.cluau file and reports.

const io = require("@std/io")
const process = require("@std/process")

// What an assertion raises: the case fails with its message, at the line
// of the assertion in the test file. Shown as that wherever it ends up (an
// assertion in a task that fails outside any case, say).
type Failure = { __cluauTestFailure: boolean, message: string, where: string }

const FailureShown = {
	__tostring = function(failure: Failure): string {
		return `{failure.where}: {failure.message}`
	},
}

const state = {
	file = "",
	filter = "",
	passed = 0,
	failed = 0,
	skipped = 0,
	exit = nil :: ((number?) -> never)?,
}

// @std/task, and a task of it whatever its function returns (Task<R...>'s
// shape): types only, as the module is loaded when the first case runs.
type TaskModule = typeof(require("@std/task"))
type Started = { done: boolean, cancelled: boolean, __returns: (...any) -> ...unknown }

// @std/task, once a case has run (nil without it), and the tasks the case
// running now has started, which it waits for before it is reported.
const tasks = {
	module = nil :: TaskModule?,
	started = nil :: { Started }?,
}

// debug.info with the options "sl": the source and the line.
const SourceLine = debug.info :: (level: number, options: string) -> (string?, number?)

// The line that called the assertion `depth` calls up (file:line).
function Where(depth: number): string {
	const source, line = SourceLine(depth + 1, "sl")
	if (source == nil || line == nil) {
		return "?"
	}
	const shown = if (string.sub(source, 1, 1) == "@") string.sub(source, 2) else source
	return `{shown}:{line}`
}

function Fail(message: string, depth: number): never {
	const failure: Failure = { __cluauTestFailure = true, message = message, where = Where(depth + 1) }
	error(setmetatable(failure, FailureShown), 0)
}

function Shown(value: unknown): string {
	return repr(value)
}

// An error as a case reports it: a failure's place and message, a string as
// it is, anything else as it shows (its __tostring, or its contents).
function Describe(problem: unknown): string {
	if (type(problem) == "table" && (problem :: Failure).__cluauTestFailure) {
		const failure = problem :: Failure
		return `{failure.where}: {failure.message}`
	}
	if (type(problem) == "string") {
		return problem :: string
	}
	const meta = getmetatable(problem)
	if (type(meta) == "table" && (meta :: { __tostring: unknown }).__tostring != nil) {
		return tostring(problem)
	}
	return `an error that is not a string: {repr(problem)}`
}

// @std/task, loaded for the cases (blocking calls then wait the way they do
// in any script with tasks); its spawn and delay note the tasks a case starts.
function TaskModule(): TaskModule? {
	if (tasks.module == nil) {
		const loaded, module = pcall(function(): TaskModule {
			return require("@std/task")
		})
		if (!loaded) {
			return nil
		}
		tasks.module = module
		const spawn = module.spawn
		const delay = module.delay
		local function Note<T>(started: T): T {
			if (tasks.started != nil) {
				// Kept without its results' type (Luau widens no Task<R...>).
				table.insert(tasks.started, (started :: unknown) :: Started)
			}
			return started
		}
		module.spawn = function(fn, ...: unknown) {
			return Note(spawn(fn, ...))
		}
		module.delay = function(seconds, fn, ...: unknown) {
			return Note(delay(seconds, fn, ...))
		}
	}
	return tasks.module
}

// The tasks a case started (and those they started) run to their end; the
// first error among them, or nil. After an error the rest are cancelled, and
// so is a task that can never finish.
function Settle(started: { Started }, failed: boolean): unknown? {
	const module = tasks.module
	if (module == nil) {
		return nil
	}
	let problem: unknown? = nil
	let i = 1
	while (i <= #started) {
		const each = started[i]
		i += 1
		if (!each.done) {
			if (failed || problem != nil) {
				module.cancel(each)
			} else {
				const joined, raised = pcall(module.join, each)
				if (!joined) {
					if (rawequal(raised, module._failure.message)) {
						problem = raised
					} else {
						module.cancel(each)
						problem = "a task the case started can never finish (nothing it waits for will happen)"
					}
				}
			}
		}
	}
	return problem
}

// Deep equality: tables are equal when their keys and values are (cycles
// compare by position), and NaN equals NaN.
function Same(a: unknown, b: unknown, seen: { [unknown]: unknown }): boolean {
	if (a == b) {
		return true
	}
	if (type(a) == "number" && type(b) == "number") {
		return a != a && b != b
	}
	if (type(a) != "table" || type(b) != "table") {
		return false
	}
	const ta = a :: { [unknown]: unknown }
	const tb = b :: { [unknown]: unknown }
	if (seen[ta] == tb) {
		return true
	}
	seen[ta] = tb
	for (key, value in ta) {
		if (!Same(value, tb[key], seen)) {
			return false
		}
	}
	for (key in tb) {
		if (ta[key] == nil) {
			return false
		}
	}
	return true
}

function Matches(name: string): boolean {
	return state.filter == "" || string.find(string.lower(name), string.lower(state.filter), 1, true) != nil
}

// A test case: `fn` runs now; a failed assertion or an error in it fails the
// case, and the file goes on with the next.
function case(name: string, fn: () -> ()) {
	if (!Matches(name)) {
		return
	}
	TaskModule()
	const outer = tasks.started
	const started: { Started } = {}
	tasks.started = started
	// (pcall's type gives a function returning nothing no error value.)
	const ok, raised = pcall(fn :: () -> ...unknown)
	// A task the case started that fails later is the case's failure, not
	// that of whichever case is running then.
	const late = Settle(started, !ok)
	tasks.started = outer
	if (ok && late == nil) {
		state.passed += 1
		io.write(`  ok    {name}\n`)
		return
	}
	state.failed += 1
	const message = Describe(if (ok) late else raised)
	io.write(`  FAIL  {name}\n`)
	for (line in string.gmatch(message, "[^\n]+")) {
		io.write(`        {line}\n`)
	}
}

// A case declared but not run (reported as skipped).
function skip(name: string, fn: () -> ()) {
	if (!Matches(name)) {
		return
	}
	state.skipped += 1
	io.write(`  skip  {name}\n`)
}

// `actual` equals `expected` (tables by their contents).
function equal(actual: unknown, expected: unknown, message: string?) {
	if (!Same(actual, expected, {})) {
		Fail(`{if (message != nil) message .. ": " else ""}expected {Shown(expected)}, got {Shown(actual)}`, 2)
	}
}

function notEqual(actual: unknown, unexpected: unknown, message: string?) {
	if (Same(actual, unexpected, {})) {
		Fail(`{if (message != nil) message .. ": " else ""}expected anything but {Shown(unexpected)}`, 2)
	}
}

// `value` is neither false nor nil.
function ok(value: unknown, message: string?) {
	if (!value) {
		Fail(message or `expected a true value, got {Shown(value)}`, 2)
	}
}

// Two numbers within `tolerance` (1e-9 by default) of each other. NaN is
// near nothing, and a NaN tolerance fails.
function near(actual: number, expected: number, tolerance: number?, message: string?) {
	if (type(actual) != "number" || type(expected) != "number") {
		Fail(`{if (message != nil) message .. ": " else ""}expected two numbers, got {Shown(actual)} and {Shown(expected)}`, 2)
	}
	const within = tolerance or 1e-9
	if (!(math.abs(actual - expected) <= within)) {
		Fail(`{if (message != nil) message .. ": " else ""}expected {expected} (within {within}), got {actual}`, 2)
	}
}

// `fn` raises an error (whose message contains `text`, when given); the
// error's message.
function raises(fn: () -> (), text: string?): string {
	const completed, problem = pcall(fn :: () -> ...unknown)
	if (completed) {
		return Fail(if (text != nil) `expected an error containing '{text}', but none was raised` else "expected an error, but none was raised", 2)
	}
	const message = if (type(problem) == "table" && (problem :: Failure).__cluauTestFailure) (problem :: Failure).message else Describe(problem)
	if (text != nil && string.find(message, text, 1, true) == nil) {
		return Fail(`expected an error containing '{text}', got '{message}'`, 2)
	}
	return message
}

// Fails the case here.
function fail(message: string): never {
	return Fail(message, 2)
}

// For `cluau test`: a file starts (its cases matching `filter`) ... While it
// runs, process.exit raises an error instead of ending every test run with
// that status: a case calling it fails, and outside a case the file does
// not finish.
function _begin(file: string, filter: string) {
	state.file = file
	state.filter = filter
	state.passed = 0
	state.failed = 0
	state.skipped = 0
	if (state.exit == nil) {
		state.exit = process.exit
		process.exit = function(code: number?): never {
			return Fail(`process.exit({code or 0}) was called during the tests`, 2)
		}
	}
}

// ... and ends: how its cases went.
function _finish(): (number, number, number) {
	if (state.exit != nil) {
		process.exit = state.exit
		state.exit = nil
	}
	return state.passed, state.failed, state.skipped
}

return {
	case = case,
	skip = skip,
	equal = equal,
	notEqual = notEqual,
	ok = ok,
	near = near,
	raises = raises,
	fail = fail,
	_begin = _begin,
	_finish = _finish,
}
