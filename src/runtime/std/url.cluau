// @std/url: web addresses (RFC 3986): parsed into their parts and put back
// together, resolved against a base, and their parts percent-encoded.
//
//   const url = require("@std/url")
//   const u = url.parse("https://ada@example.com:8443/docs/a%20b?q=1#top")
//   print(u.scheme, u.host, u.port, u.path)        // https example.com 8443 /docs/a b
//   print(u.rawPath)                                // /docs/a%20b
//   print(url.resolve("https://example.com/a/b", "../c?x=1"))  // https://example.com/c?x=1
//   print(url.encodeQuery({ q = "two words", page = "2" }))   // page=2&q=two%20words

export type Url = {
	scheme: string,   // "https" ("" for a relative address)
	user: string,     // "" when there is none
	password: string,
	host: string,     // without the brackets of an IPv6 address
	port: number?,    // nil when the address gives none
	authority: boolean?, // the address has a // part (http:///x has one with no host); nil: one when there is a host
	path: string,     // decoded
	rawPath: string?, // as written (format keeps it while it decodes to `path`)
	query: string,    // as written, without the ?
	fragment: string, // as written, without the #
}

// Percent-encodes everything but the unreserved characters (letters,
// digits, - . _ ~); `keep` names more to leave as they are ("/" for a path).
const encode = function(text: string, keep: string?): string {
	const extra = keep or ""
	const encoded = string.gsub(text, "[^%w%-%._~]", function(c: string): string {
		if (string.find(extra, c, 1, true) != nil) {
			return c
		}
		return string.format("%%%02X", string.byte(c))
	})
	return encoded
}

// %XX back to its byte; `plus` also reads + as a space (a query's form).
const decode = function(text: string, plus: boolean?): string {
	const spaced = if (plus) string.gsub(text, "+", " ") else text
	const decoded = string.gsub(spaced, "%%(%x%x)", function(hex: string): string {
		return string.char(tonumber(hex, 16) or 0)
	})
	return decoded
}

// A query string's names and values (decoded; a later repeat wins). Pairs
// are split at & only, as browsers do (a ; is part of a value).
const parseQuery = function(text: string): { [string]: string } {
	const out: { [string]: string } = {}
	const trimmed = if (string.sub(text, 1, 1) == "?") string.sub(text, 2) else text
	for (pair in string.gmatch(trimmed, "[^&]+")) {
		const name, value = string.match(pair, "^([^=]*)=?(.*)$")
		if (name != nil && name != "") {
			out[decode(name, true)] = decode(value or "", true)
		}
	}
	return out
}

// A query string from names and values, in the names' order (as text, so
// a number as a name sorts among the others).
const encodeQuery = function(values: { [string]: string | number | boolean }): string {
	const names: { string } = {}
	const byName: { [string]: string | number | boolean } = {}
	for (name, value in values :: { [unknown]: string | number | boolean }) {
		const shown = tostring(name)
		table.insert(names, shown)
		byName[shown] = value
	}
	table.sort(names)
	const parts: { string } = {}
	for (_, name in names) {
		table.insert(parts, encode(name) .. "=" .. encode(tostring(byName[name])))
	}
	return table.concat(parts, "&")
}

// A port as written (digits, or nothing), or an error (raised at the line
// that called url.parse or url.resolve).
const Port = function(text: string, written: string): number? {
	if (text == "") {
		return nil
	}
	const port = if (string.find(text, "^%d+$") != nil) tonumber(text) else nil
	if (port == nil || port > 65535) {
		error(`url.parse: '{written}' has a port that is not a number from 0 to 65535`, 4)
	}
	return port
}

const Parse = function(text: string): Url {
	const u: Url = {
		scheme = "",
		user = "",
		password = "",
		host = "",
		port = nil,
		authority = false,
		path = "",
		rawPath = "",
		query = "",
		fragment = "",
	}
	let rest = text
	const fragmentAt = string.find(rest, "#", 1, true)
	if (fragmentAt != nil) {
		u.fragment = string.sub(rest, fragmentAt + 1)
		rest = string.sub(rest, 1, fragmentAt - 1)
	}
	const queryAt = string.find(rest, "?", 1, true)
	if (queryAt != nil) {
		u.query = string.sub(rest, queryAt + 1)
		rest = string.sub(rest, 1, queryAt - 1)
	}
	const scheme, afterScheme = string.match(rest, "^(%a[%w+%-.]*):(.*)$")
	if (scheme != nil && afterScheme != nil) {
		u.scheme = string.lower(scheme)
		rest = afterScheme
	}
	if (string.sub(rest, 1, 2) == "//") {
		u.authority = true
		const authority = string.match(rest, "^//([^/]*)") or ""
		rest = string.sub(rest, 3 + #authority)
		const userinfo, hostport = string.match(authority, "^(.*)@(.*)$")
		let where = authority
		if (userinfo != nil && hostport != nil) {
			where = hostport
			const user, password = string.match(userinfo, "^([^:]*):?(.*)$")
			u.user = decode(user or "")
			u.password = decode(password or "")
		}
		// [IPv6]:port, or host:port; the port may be left empty (host:).
		const bracketed, after = string.match(where, "^%[([^%]]*)%](.*)$")
		if (bracketed != nil && after != nil) {
			if (after != "" && string.sub(after, 1, 1) != ":") {
				error(`url.parse: '{text}' has text after its IPv6 address`, 3)
			}
			u.host = bracketed
			u.port = Port(string.sub(after, 2), text)
		} else {
			const host, port = string.match(where, "^([^:]*):(.*)$")
			if (host != nil && port != nil) {
				u.host = string.lower(host)
				u.port = Port(port, text)
			} else {
				u.host = string.lower(where)
			}
		}
	}
	u.rawPath = rest
	u.path = decode(rest)
	return u
}

// The address's parts; a port that is not one is an error.
const parse = function(text: string): Url {
	const u = Parse(text)
	return u
}

// The path as an address has it: `rawPath` while it is `path` encoded (so
// %2F stays %2F), else `path` encoded.
const EncodedPath = function(u: Url): string {
	const raw = u.rawPath
	if (raw != nil && decode(raw) == u.path) {
		// Kept, but for what may not stand in a path as it is (a space).
		const kept = string.gsub(raw, "[^%w%-%._~!$&'()*+,;=:@/%%]", function(c: string): string {
			return string.format("%%%02X", string.byte(c))
		})
		return kept
	}
	return encode(u.path, "/:@!$&'()*+,;=")
}

// The address from its parts; `query` and `fragment` say whether an empty
// query or fragment is there (a ? or # with nothing after it).
const Format = function(u: Url, query: boolean, fragment: boolean): string {
	const parts: { string } = {}
	if (u.scheme != "") {
		table.insert(parts, u.scheme .. ":")
	}
	// A // part: as the address had it, or (for a table made by hand) when
	// there is a host, or a file: address's absolute path.
	const authority = if (u.authority != nil) u.authority
		else u.host != "" || (u.scheme == "file" && string.sub(u.path, 1, 1) == "/")
	if (authority) {
		table.insert(parts, "//")
		if (u.user != "" || u.password != "") {
			table.insert(parts, encode(u.user))
			if (u.password != "") {
				table.insert(parts, ":" .. encode(u.password))
			}
			table.insert(parts, "@")
		}
		table.insert(parts, if (string.find(u.host, ":", 1, true) != nil) `[{u.host}]` else u.host)
		if (u.port != nil) {
			table.insert(parts, ":" .. tostring(u.port))
		}
	}
	table.insert(parts, EncodedPath(u))
	if (u.query != "" || query) {
		table.insert(parts, "?" .. u.query)
	}
	if (u.fragment != "" || fragment) {
		table.insert(parts, "#" .. u.fragment)
	}
	return table.concat(parts)
}

// The address again, from its parts (the path as written, or encoded).
const format = function(u: Url): string {
	return Format(u, false, false)
}

// A path's "." and ".." segments taken out (RFC 3986, 5.2.4); empty
// segments stay (a//b).
const RemoveDots = function(path: string): string {
	const out: { string } = {}
	let input = path
	while (input != "") {
		if (string.sub(input, 1, 3) == "../") {
			input = string.sub(input, 4)
		} else if (string.sub(input, 1, 2) == "./") {
			input = string.sub(input, 3)
		} else if (string.sub(input, 1, 3) == "/./") {
			input = "/" .. string.sub(input, 4)
		} else if (input == "/.") {
			input = "/"
		} else if (string.sub(input, 1, 4) == "/../" || input == "/..") {
			input = "/" .. string.sub(input, 5)
			table.remove(out)
		} else if (input == "." || input == "..") {
			input = ""
		} else {
			const segment = string.match(input, "^/?[^/]*") or input
			table.insert(out, segment)
			input = string.sub(input, #segment + 1)
		}
	}
	return table.concat(out)
}

// `relative` resolved against `base` (RFC 3986, 5.2).
const resolve = function(base: string, relative: string): string {
	const b = Parse(base)
	const r = Parse(relative)
	const t: Url = {
		scheme = "",
		user = "",
		password = "",
		host = "",
		port = nil,
		authority = false,
		path = "",
		rawPath = "",
		query = "",
		fragment = r.fragment,
	}
	const beforeFragment = string.match(relative, "^[^#]*") or relative
	const rQuery = string.find(beforeFragment, "?", 1, true) != nil
	const bQuery = string.find(string.match(base, "^[^#]*") or base, "?", 1, true) != nil
	let query = rQuery
	const bPath = b.rawPath or ""
	const rPath = r.rawPath or ""
	let raw: string
	if (r.scheme != "") {
		t.scheme = r.scheme
		t.user, t.password, t.host, t.port, t.authority = r.user, r.password, r.host, r.port, r.authority
		raw = RemoveDots(rPath)
		t.query = r.query
	} else {
		t.scheme = b.scheme
		if (r.authority) {
			t.user, t.password, t.host, t.port, t.authority = r.user, r.password, r.host, r.port, true
			raw = RemoveDots(rPath)
			t.query = r.query
		} else {
			t.user, t.password, t.host, t.port, t.authority = b.user, b.password, b.host, b.port, b.authority
			if (rPath == "") {
				raw = bPath
				if (rQuery) {
					t.query = r.query
				} else {
					t.query = b.query
					query = bQuery
				}
			} else {
				if (string.sub(rPath, 1, 1) == "/") {
					raw = RemoveDots(rPath)
				} else {
					const dir = string.match(bPath, "^(.*/)") or (if (b.authority) "/" else "")
					raw = RemoveDots(dir .. rPath)
				}
				t.query = r.query
			}
		}
	}
	t.rawPath = raw
	t.path = decode(raw)
	return Format(t, query, string.find(relative, "#", 1, true) != nil)
}

return {
	parse = parse,
	format = format,
	resolve = resolve,
	encode = encode,
	decode = decode,
	parseQuery = parseQuery,
	encodeQuery = encodeQuery,
}
