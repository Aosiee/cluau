// @std/server: an HTTP/1.1 server over @std/net and @std/task. Each
// connection is a task of its own (several requests one after another on
// it: keep-alive), and a handler answers each request.
//
//   const server = require("@std/server")
//   server.serve({ port = 8080 }, function(request: server.Request): server.Answer {
//   	return { status = 200, headers = { ["content-type"] = "text/plain" }, body = "hello" }
//   })
//
// serve returns at once: the server runs in tasks, so it goes on after the
// script's last line (until it is closed, or Ctrl-C). A handler may answer
// with a table (status, headers, body), a string (200, text), or nil
// (404); an error in it, or an answer of another kind, is a 500, with the
// error on stderr. Nothing a client sends, and nothing a handler answers,
// ends the server: an error on one connection ends that connection.

const net = require("@std/net")
const task = require("@std/task")
const fs = require("@std/fs")
const path = require("@std/path")
const io = require("@std/io")
const websocket = require("@std/websocket")

export type Request = {
	method: string,
	path: string,         // without the query, decoded
	target: string,       // as the request line gave it
	version: string,      // "1.1" or "1.0"
	query: { [string]: string },
	headers: { [string]: string }, // names in lowercase
	body: string,
	params: { [string]: string },  // a router's :name parts
	remoteHost: string,
	remotePort: number,
	socket: net.Socket,
}
// A file files() answers with: sent as it is read, not read whole first.
class FileBody {
	File: fs.File
	Size: number = 0
	function Init(file: fs.File, size: number) {
		self.File = file
		self.Size = size
	}
}

export type Response = { status: number?, headers: { [string]: string }?, body: (string | buffer | FileBody)? }
// An Upgrade is what upgrade() answers with.
export type Answer = Response | string | Upgrade | nil
export type Handler = (request: Request) -> Answer
export type Options = {
	host: string?,      // "127.0.0.1" (this machine only) by default
	port: number?,      // 8080 by default; 0 for any free one
	tls: { certFile: string, keyFile: string }?,
	maxBody: number?,   // bytes a request's body may have (16 MiB by default)
	idle: number?,      // seconds a connection may wait between requests (60)
	headTimeout: number?, // seconds a request's head may take from its first byte (30; 0: no limit)
}

const kReasons: { [number]: string } = {
	[101] = "Switching Protocols", [200] = "OK", [201] = "Created", [204] = "No Content", [301] = "Moved Permanently", [302] = "Found",
	[304] = "Not Modified", [400] = "Bad Request", [401] = "Unauthorized", [403] = "Forbidden", [404] = "Not Found",
	[405] = "Method Not Allowed", [408] = "Request Timeout", [413] = "Content Too Large", [414] = "URI Too Long",
	[417] = "Expectation Failed", [426] = "Upgrade Required", [431] = "Request Header Fields Too Large",
	[500] = "Internal Server Error", [501] = "Not Implemented", [503] = "Service Unavailable",
	[505] = "HTTP Version Not Supported",
}

// The most a line of a request's head may have, and the whole head (its
// request line and headers).
const kLineLimit = 64 * 1024
const kHeadLimit = 256 * 1024

// The headers a handler's answer may not give: the server frames the
// answer itself, and these belong to one connection, not to the answer
// (a relayed answer's Transfer-Encoding would contradict its framing).
const kFraming: { [string]: boolean } = {
	["content-length"] = true, connection = true, ["transfer-encoding"] = true, te = true, trailer = true, upgrade = true,
	["keep-alive"] = true,
}

// How much of a body is written at a time: a client that reads slowly
// holds this much of the server's memory, and each piece must be taken
// within the connection's idle time.
const kSlice = 256 * 1024

// %XX (and + in a query) back to their characters.
const Decode = function(text: string, query: boolean): string {
	const spaced = if (query) string.gsub(text, "+", " ") else text
	const decoded = string.gsub(spaced, "%%(%x%x)", function(hex: string): string {
		return string.char(tonumber(hex, 16) or 0)
	})
	return decoded
}

const ParseQuery = function(text: string): { [string]: string } {
	const query: { [string]: string } = {}
	for (pair in string.gmatch(text, "[^&]+")) {
		const name, value = string.match(pair, "^([^=]*)=?(.*)$")
		if (name != nil && name != "") {
			query[Decode(name, true)] = Decode(value or "", true)
		}
	}
	return query
}

const Exactly = function(socket: net.Socket, count: number): string? {
	const parts: { string } = {}
	let have = 0
	while (have < count) {
		const chunk = socket:read(math.min(count - have, 65536))
		if (chunk == nil) {
			return nil
		}
		table.insert(parts, chunk)
		have += #chunk
	}
	return table.concat(parts)
}

class Failure {
	Status: number = 400
	Message: string = ""
	function Init(status: number, message: string) {
		self.Status = status
		self.Message = message
	}
}

const Fail = function(status: number, message: string): never {
	error(Failure(status, message), 0)
}

// Whether `value` is an instance of the class `of` (FileBody, Failure,
// Upgrade): whether that is its metatable.
const IsInstance = function(value: unknown, of: unknown): boolean {
	return getmetatable(value) == of
}

// A line of a request's head or of a chunked body's framing, of at most
// `limit` bytes: a longer one is answered with `status` and `message`, and
// a head that is not in by its deadline with 408.
const ReadLine = function(socket: net.Socket, limit: number, status: number, message: string): string? {
	const ok, line = pcall(function(): string? {
		return socket:readLine(limit)
	})
	if (!ok) {
		if (string.find(tostring(line), "longer than", 1, true) != nil) {
			Fail(status, message)
		}
		if (string.find(tostring(line), "setDeadline", 1, true) != nil) {
			Fail(408, "the request's head took too long")
		}
		error(line, 0)
	}
	return line
}

// A request's target in origin form (/path?query): an absolute one
// (http://host/path) without its scheme and host.
const OriginForm = function(target: string): string {
	const rest = string.match(target, "^%a[%w+.-]*://[^/?#]*(.*)$")
	if (rest == nil) {
		return target
	}
	return if (string.sub(rest, 1, 1) == "/") rest else "/" .. rest
}

// A comma-separated list of tokens (Connection's), in lowercase.
const Tokens = function(text: string?): { [string]: boolean } {
	const tokens: { [string]: boolean } = {}
	for (part in string.gmatch(string.lower(text or ""), "[^,]+")) {
		tokens[string.match(part, "^[ \t]*(.-)[ \t]*$") or part] = true
	}
	return tokens
}

// A chunked body (its trailers read and left out); nil when it ends early.
const ReadChunked = function(socket: net.Socket, maxBody: number): string {
	const parts: { string } = {}
	let size = 0
	while (true) {
		const sizeLine = ReadLine(socket, kLineLimit, 400, "a chunk's size line is too long")
		if (sizeLine == nil) {
			return Fail(400, "the body ends before its last chunk")
		}
		// The size in hex, then perhaps ;extensions.
		const hex = string.match(sizeLine, "^%x+")
		if (hex == nil) {
			return Fail(400, "a chunk's size is a hexadecimal number")
		}
		const rest = string.sub(sizeLine, #hex + 1)
		if (rest != "" && string.find(rest, "^[ \t]*;") == nil) {
			Fail(400, "a chunk's size is a hexadecimal number")
		}
		if (#hex > 12) {
			Fail(413, `a body of more than {maxBody} bytes`)
		}
		const chunk = tonumber(hex, 16) :: number
		if (chunk == 0) {
			let trailers = 0
			while (true) {
				const trailer = ReadLine(socket, kLineLimit, 431, `a trailer of more than {kLineLimit} bytes`)
				if (trailer == nil) {
					Fail(400, "the body ends inside its trailers")
				}
				if (trailer == "") {
					break
				}
				trailers += 1
				if (trailers > 100) {
					Fail(431, "more than 100 trailers")
				}
			}
			break
		}
		size += chunk
		if (size > maxBody) {
			Fail(413, `a body of more than {maxBody} bytes`)
		}
		const data = Exactly(socket, chunk)
		if (data == nil) {
			return Fail(400, "the body ends inside a chunk")
		}
		table.insert(parts, data)
		if (ReadLine(socket, kLineLimit, 400, "a chunk does not end with a line break") != "") {
			Fail(400, "a chunk does not end with a line break")
		}
	}
	return table.concat(parts)
}

// The next request on the connection (nil when it closed between requests),
// and whether the connection may be kept after it. `busy` is called once
// its first byte has arrived; from then its head (the request line and the
// headers) has `headTimeout` seconds in all, however it arrives.
const ReadRequest = function(socket: net.Socket, maxBody: number, headTimeout: number, busy: () -> ()): (Request?, boolean) {
	const first = socket:read(1)
	if (first == nil) {
		return nil, false
	}
	busy()
	if (headTimeout > 0) {
		socket:setDeadline(headTimeout)
	}
	const tooLong = `a request line of more than {kLineLimit} bytes`
	let line: string? = ""
	if (first == "\r") {
		const rest = ReadLine(socket, kLineLimit - 1, 414, tooLong)
		line = if (rest == "") "" else "\r" .. (rest or "")
	} else if (first != "\n") {
		line = first .. (ReadLine(socket, kLineLimit - 1, 414, tooLong) or "")
	}
	// Browsers may send an empty line between requests.
	let blank = 0
	while (line == "" && blank < 16) {
		blank += 1
		line = ReadLine(socket, kLineLimit, 414, tooLong)
	}
	if (line == nil) {
		return nil, false
	}
	const method, target, version = string.match(line, "^(%u+) (%S+) HTTP/(%d%.%d)$")
	if (method == nil || target == nil || version == nil) {
		return Fail(400, "a request line is METHOD /path HTTP/1.1")
	}
	if (version != "1.1" && version != "1.0") {
		Fail(505, `HTTP/{version} (this server speaks HTTP/1.1 and 1.0)`)
	}
	const headers: { [string]: string } = {}
	let count = 0
	let hosts = 0
	let head = #line
	while (true) {
		const room = kHeadLimit - head
		const header = if (room >= kLineLimit) ReadLine(socket, kLineLimit, 431, `a header line of more than {kLineLimit} bytes`)
			else ReadLine(socket, room + 1, 431, `headers of more than {kHeadLimit} bytes`)
		if (header == nil) {
			return nil, false
		}
		if (header == "") {
			break
		}
		head += #header + 2
		if (head > kHeadLimit) {
			Fail(431, `headers of more than {kHeadLimit} bytes`)
		}
		count += 1
		if (count > 100) {
			Fail(431, "more than 100 headers")
		}
		// A name is a token; white space around a value is spaces and tabs
		// only, and a value has no control characters (CR, NUL) but tabs.
		const name, value = string.match(header, "^([%w!#$%%&'*+%-.^_`|~]+):[ \t]*(.-)[ \t]*$")
		if (name == nil || value == nil) {
			return Fail(400, "a header is Name: value")
		}
		if (string.find(value, "[%z\1-\8\10-\31\127]") != nil) {
			Fail(400, `the {name} header's value has a control character in it`)
		}
		const key = string.lower(name)
		if (key == "host") {
			hosts += 1
		}
		headers[key] = if (headers[key] != nil) headers[key] .. ", " .. value else value
	}
	// An HTTP/1.1 request names its host, once.
	if (version == "1.1" && hosts != 1) {
		Fail(400, if (hosts == 0) "an HTTP/1.1 request has a Host header" else "a request has one Host header")
	}
	socket:setDeadline(nil)
	const connection = Tokens(headers["connection"])
	let keep = if (version == "1.1") !connection["close"] else connection["keep-alive"] == true && !connection["close"]
	if (version == "1.0" && headers["connection"] == nil) {
		headers["connection"] = "close"
	}
	// The body: in chunks, or by its length. Both, or a coding other than
	// chunked, is refused: two servers could read the request differently.
	const encoding = headers["transfer-encoding"]
	const declared = headers["content-length"]
	let length: number? = nil
	let chunked = false
	if (encoding != nil) {
		if (declared != nil) {
			Fail(400, "a request has Transfer-Encoding or Content-Length, not both")
		}
		const codings: { string } = {}
		for (coding in string.gmatch(string.lower(encoding), "[^,]+")) {
			table.insert(codings, string.match(coding, "^[ \t]*(.-)[ \t]*$") or coding)
		}
		if (codings[#codings] != "chunked") {
			Fail(400, "a Transfer-Encoding ends with chunked")
		}
		if (#codings > 1) {
			Fail(501, `Transfer-Encoding {encoding} (only chunked is understood)`)
		}
		chunked = true
		// An HTTP/1.0 message cannot be framed so (RFC 9112 6.1): it is
		// read, and the connection closes after it.
		if (version == "1.0") {
			keep = false
		}
	} else if (declared != nil) {
		// Digits only; repeated, the same number each time.
		for (part in string.gmatch(declared .. ",", "([^,]*),")) {
			const digits = string.match(part, "^[ \t]*(%d+)[ \t]*$")
			if (digits == nil) {
				Fail(400, "Content-Length is a number of bytes")
			}
			const n = tonumber(digits) :: number
			if (length != nil && n != length) {
				Fail(400, "two different Content-Lengths")
			}
			length = n
		}
		if ((length :: number) > maxBody) {
			Fail(413, `a body of {declared} bytes (at most {maxBody})`)
		}
	}
	// A client that waits to be told to send its body is told.
	const expect = headers["expect"]
	if (expect != nil) {
		if (string.lower(expect) != "100-continue") {
			Fail(417, `Expect: {expect}`)
		}
		if (version != "1.0" && (chunked || (length or 0) > 0)) {
			socket:write("HTTP/1.1 100 Continue\r\n\r\n")
		}
	}
	let body = ""
	if (chunked) {
		body = ReadChunked(socket, maxBody)
	} else if (length != nil && length > 0) {
		body = Exactly(socket, length) or Fail(400, `the body ends before its {length} bytes`)
	}
	const origin = OriginForm(target)
	const rawPath, rawQuery = string.match(origin, "^([^?]*)%??(.*)$")
	return {
		method = method,
		path = Decode(rawPath or origin, false),
		target = target,
		version = version,
		query = ParseQuery(rawQuery or ""),
		headers = headers,
		body = body,
		params = {},
		remoteHost = socket.remoteHost,
		remotePort = socket.remotePort,
		socket = socket,
	}, keep
}

// A handler's answer as a response, checked: a status from 200 to 999; a
// body that is a string, a buffer or a file; headers whose names are header
// names and whose values (strings or numbers) cannot end the header they are
// in (no line break), so a handler cannot add a header or a body it did not
// mean to. Anything else is an error, which the server answers with a 500.
const Prepare = function(answer: unknown): Response {
	if (answer == nil) {
		return { status = 404, body = "Not Found" }
	}
	if (type(answer) == "string") {
		return { status = 200, body = answer :: string }
	}
	if (type(answer) != "table") {
		error(`server: the handler answered with a {typeof(answer)} (a table, a string or nil)`, 0)
	}
	const response = answer :: Response
	const status = response.status
	if (status != nil && (type(status) != "number" || status != math.floor(status) || status < 200 || status > 999)) {
		error(`server: the status {repr(status)} is not a whole number from 200 to 999`, 0)
	}
	const body: unknown = response.body
	if (body != nil && type(body) != "string" && type(body) != "buffer" && !IsInstance(body, FileBody)) {
		error(`server: the body is a {typeof(body)} (a string or a buffer)`, 0)
	}
	const headers: unknown = response.headers
	if (headers != nil && type(headers) != "table") {
		error(`server: the headers are a {typeof(headers)} (a table of names and values)`, 0)
	}
	for (name, value in (headers or {}) :: { [unknown]: unknown }) {
		if (type(name) != "string" || string.find(name :: string, "^[%w!#$%%&'*+%-.^_`|~]+$") == nil) {
			error(`server: '{tostring(name)}' is not a header name`, 0)
		}
		if (type(value) != "string" && type(value) != "number") {
			error(`server: the {name} header's value is a {typeof(value)} (a string)`, 0)
		}
		if (string.find(tostring(value), "[\r\n%z]") != nil) {
			error(`server: the {name} header's value has a line break in it`, 0)
		}
	}
	return response
}

// Writes `count` bytes of a body from `piece(offset, count)`, a slice at a
// time, each within `idle` seconds (0: no limit).
const WriteSlices = function(socket: net.Socket, size: number, idle: number, piece: (offset: number, count: number) -> string) {
	let sent = 0
	while (sent < size) {
		const count = math.min(kSlice, size - sent)
		const data = piece(sent, count)
		if (#data != count) {
			error("server: the file ended before its size", 0)
		}
		if (idle > 0) {
			socket:setDeadline(idle)
		}
		socket:write(data)
		sent += count
	}
	socket:setDeadline(nil)
}

// Sends a prepared response: Content-Length (none for a 204 or a 304, which
// have no body), and Connection; the body, if any, a slice at a time.
const Write = function(socket: net.Socket, request: Request?, response: Response, keepAlive: boolean, idle: number) {
	const status = response.status or 200
	const given = response.body
	const file = if (IsInstance(given, FileBody)) given :: FileBody else nil
	const size = if (file != nil) file.Size else if (type(given) == "buffer") buffer.len(given) else #((given :: string?) or "")
	const bodiless = status == 204 || status == 304
	const lines = { `HTTP/1.1 {status} {kReasons[status] or "Status"}` }
	let typed = false
	const headers: { [string]: string } = response.headers or {}
	for (name, value in headers) {
		const lower = string.lower(name)
		if (!kFraming[lower]) {
			table.insert(lines, `{name}: {value}`)
		}
		typed = typed || lower == "content-type"
	}
	if (!bodiless) {
		if (!typed && size > 0) {
			table.insert(lines, "Content-Type: text/plain; charset=utf-8")
		}
		table.insert(lines, `Content-Length: {size}`)
	}
	table.insert(lines, if (keepAlive) "Connection: keep-alive" else "Connection: close")
	const head = table.concat(lines, "\r\n") .. "\r\n\r\n"
	if (bodiless || size == 0 || (request != nil && request.method == "HEAD")) {
		socket:write(head)
	} else if (file != nil) {
		socket:write(head)
		WriteSlices(socket, size, idle, function(offset: number, count: number): string {
			return file.File:read(count) or ""
		})
	} else if (type(given) == "buffer") {
		socket:write(head)
		WriteSlices(socket, size, idle, function(offset: number, count: number): string {
			return buffer.readstring(given, offset, count)
		})
	} else if (size <= kSlice) {
		socket:write(head, given :: string)
	} else {
		socket:write(head)
		WriteSlices(socket, size, idle, function(offset: number, count: number): string {
			return string.sub(given :: string, offset + 1, offset + count)
		})
	}
}

// A file body is closed once it is sent (or not).
const Done = function(response: Response?) {
	const given = if (response != nil) response.body else nil
	if (IsInstance(given, FileBody)) {
		pcall(function() {
			(given :: FileBody).File:close()
		})
	}
}

// What upgrade() answers with: the connection becomes a WebSocket.
class Upgrade {
	Run: ((ws: websocket.WebSocket) -> ())? = nil
	Accept: string = "" // the handshake's answer to the request's key
	function Init(run: (ws: websocket.WebSocket) -> (), accept: string) {
		self.Run = run
		self.Accept = accept
	}
}

// A request's answer that makes the connection a WebSocket: `run` gets it
// (and the connection ends when run returns). The request is checked as
// RFC 6455 4.2.1 has it: a GET of HTTP/1.1, Upgrade: websocket, Connection:
// Upgrade, a key of 16 bytes in base64 (400 otherwise), and version 13 (426
// otherwise, naming it).
const upgrade = function(request: Request, run: (ws: websocket.WebSocket) -> ()): Answer {
	const key = request.headers["sec-websocket-key"] or ""
	if (request.method != "GET" || request.version != "1.1" || !Tokens(request.headers["upgrade"])["websocket"] ||
		!Tokens(request.headers["connection"])["upgrade"] || #key != 24 || string.find(key, "^[%w+/]+==$") == nil) {
			return { status = 400, body = "a WebSocket request (GET, HTTP/1.1, Upgrade: websocket, Connection: Upgrade, Sec-WebSocket-Key)" }
		}
	if (request.headers["sec-websocket-version"] != "13") {
		return { status = 426, headers = { ["Sec-WebSocket-Version"] = "13" }, body = "WebSocket version 13" }
	}
	// An error in a build without @std/crypto: the handler's, so a 500.
	return Upgrade(run, websocket._accept(key))
}

class Running {
	Server: net.Server
	Closed: boolean = false
	// The connections waiting for their next request (closed by close()).
	Idle: { [net.Socket]: boolean } = {}
	host: string = ""
	port: number = 0
	function Init(server: net.Server) {
		self.Server = server
		self.host = server.host
		self.port = server.port
	}
	// Stops taking connections: those waiting for a request are closed, and
	// those with a request under way finish it.
	function close() {
		if (self.Closed) {
			return
		}
		self.Closed = true
		self.Server:close()
		for (socket in self.Idle) {
			pcall(function() {
				socket:close()
			})
		}
		table.clear(self.Idle)
	}
}

// After answering a request that was not read to its end: what the client
// is still sending is read and dropped for a moment (half a second in all)
// before closing. Closing with it unread would reset the connection, and the
// client could lose the answer.
const Linger = function(socket: net.Socket) {
	pcall(function() {
		socket:setDeadline(0.5)
		let dropped = 0
		while (dropped < 1024 * 1024) {
			const chunk = socket:read()
			if (chunk == nil) {
				break
			}
			dropped += #chunk
		}
	})
}

// The 500 for a handler's error (or answer it cannot give), with the error
// on stderr.
const Broken = function(socket: net.Socket, request: Request, problem: unknown, idle: number) {
	io.writeError(`server: {request.method} {request.path}: {tostring(problem)}\n`)
	pcall(Write, socket, request, { status = 500, body = "Internal Server Error" }, false, idle)
}

// A connection's requests, one after another, until it closes, a request
// asks it to, or one cannot be answered.
const Connection = function(socket: net.Socket, handler: Handler, options: Options, running: Running) {
	const idle = options.idle or 60
	socket:setTimeout(idle)
	const maxBody = options.maxBody or 16 * 1024 * 1024
	const headTimeout = options.headTimeout or 30
	while (!running.Closed) {
		running.Idle[socket] = true
		const read, request, keep = pcall(ReadRequest, socket, maxBody, headTimeout, function() {
			running.Idle[socket] = nil
		})
		running.Idle[socket] = nil
		if (!read) {
			// A broken request is answered; a connection gone quiet just ends.
			const problem: unknown = request
			if (typeof(problem) == "table" && IsInstance(problem, Failure)) {
				const failure = problem :: Failure
				socket:setDeadline(nil) // the head's, which may be what passed
				pcall(Write, socket, nil, { status = failure.Status, body = failure.Message }, false, idle)
				Linger(socket)
			}
			return
		}
		if (request == nil) {
			return
		}
		const keepAlive = keep :: boolean
		// What the handler answered or raised: an Upgrade from upgrade() too.
		const answered, answer = pcall(handler, request)
		const result: unknown = answer
		if (!answered) {
			Broken(socket, request, result, idle)
			return
		}
		if (typeof(result) == "table" && IsInstance(result, Upgrade)) {
			const up = result :: Upgrade
			// The client may be gone already: that connection just ends.
			const switched = pcall(function() {
				socket:write("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ", up.Accept,
					"\r\n\r\n")
			})
			if (!switched) {
				return
			}
			socket:setTimeout(0)
			const ws = websocket._fromSocket(socket)
			const ran, problem = pcall(up.Run :: (ws: websocket.WebSocket) -> ...unknown, ws)
			if (!ran) {
				io.writeError(`server: the WebSocket at {request.path}: {tostring(problem)}\n`)
			}
			pcall(function() {
				ws:close()
			})
			return
		}
		const prepared, response = pcall(Prepare, result)
		if (!prepared) {
			Broken(socket, request, response, idle)
			return
		}
		const wrote = pcall(Write, socket, request, response, keepAlive && !running.Closed, idle)
		Done(response)
		if (!wrote || !keepAlive) {
			return
		}
	}
}

// A connection's task: whatever goes wrong on it ends it, not the server
// (an error in a task would end the script).
const Serve = function(socket: net.Socket, handler: Handler, options: Options, running: Running) {
	// (Connection returns nothing, which pcall's type gives no error value.)
	const ok, problem = pcall(Connection :: (net.Socket, Handler, Options, Running) -> ...unknown, socket, handler, options, running)
	running.Idle[socket] = nil
	if (!ok) {
		io.writeError(`server: a connection from {socket.remoteHost}: {tostring(problem)}\n`)
	}
	pcall(function() {
		socket:close()
	})
}

// Serves `handler` on options.host and options.port; returns at once.
const serve = function(options: Options?, handler: Handler): Running {
	const given: Options = options or {}
	const listening = net.listen(given.host or "127.0.0.1", given.port or 8080, { tls = given.tls })
	const running = Running(listening)
	task.spawn(function() {
		// A failed accept (out of file descriptors, say) is reported and
		// tried again after a pause, longer each time it fails again; only
		// close() ends the loop.
		let pause = 0.05
		while (!running.Closed) {
			const accepted, socket = pcall(function(): net.Socket {
				return listening:accept()
			})
			if (running.Closed) {
				if (accepted) {
					pcall(function() {
						socket:close()
					})
				}
				break
			}
			if (accepted) {
				pause = 0.05
				task.spawn(Serve, socket, handler, given, running)
			} else {
				io.writeError(`server: accepting a connection: {tostring(socket)} (trying again in {pause} s)\n`)
				task.wait(pause)
				pause = math.min(pause * 2, 2)
			}
		}
	})
	return running
}

// ---- routing --------------------------------------------------------------

type Route = { Method: string, Parts: { string }, Handler: Handler }

class Router {
	Routes: { Route } = {}

	// `pattern`'s parts: literal, :name (a part, given as request.params.name)
	// or * (the rest of the path, as request.params["*"]).
	function route(method: string, pattern: string, handler: Handler): Router {
		const parts: { string } = {}
		for (part in string.gmatch(pattern, "[^/]+")) {
			table.insert(parts, part)
		}
		table.insert(self.Routes, { Method = string.upper(method), Parts = parts, Handler = handler })
		return self
	}
	function get(pattern: string, handler: Handler): Router {
		return self:route("GET", pattern, handler)
	}
	function post(pattern: string, handler: Handler): Router {
		return self:route("POST", pattern, handler)
	}
	function put(pattern: string, handler: Handler): Router {
		return self:route("PUT", pattern, handler)
	}
	function delete(pattern: string, handler: Handler): Router {
		return self:route("DELETE", pattern, handler)
	}

	// The first route the request's path and method match.
	function handle(request: Request): Answer {
		// The path's parts as the request wrote them, each decoded after, so
		// that /users/a%2Fb has the one part a/b.
		const raw = string.match(OriginForm(request.target), "^/[^?]*")
		const source = if (raw != nil && Decode(raw, false) == request.path) raw else nil
		const parts: { string } = {}
		for (part in string.gmatch(source or request.path, "[^/]+")) {
			table.insert(parts, if (source != nil) Decode(part, false) else part)
		}
		let pathMatched = false
		for (_, route in self.Routes) {
			const params: { [string]: string } = {}
			let matches = true
			for (i, part in route.Parts) {
				if (part == "*") {
					params["*"] = table.concat(parts, "/", i)
					break
				}
				const given = parts[i]
				if (given == nil) {
					matches = false
					break
				}
				if (string.sub(part, 1, 1) == ":") {
					params[string.sub(part, 2)] = given
				} else if (part != given) {
					matches = false
					break
				}
			}
			const last = route.Parts[#route.Parts]
			if (matches && last != "*" && #parts != #route.Parts) {
				matches = false
			}
			if (matches) {
				pathMatched = true
				if (route.Method == request.method || (route.Method == "GET" && request.method == "HEAD")) {
					request.params = params
					return route.Handler(request)
				}
			}
		}
		if (pathMatched) {
			return { status = 405, body = "Method Not Allowed" }
		}
		return nil
	}

	// The router as a handler, for serve.
	function handler(): Handler {
		return function(request: Request): Answer {
			return self:handle(request)
		}
	}
}

const router = function(): Router {
	return Router()
}

// ---- files ----------------------------------------------------------------

const kTypes: { [string]: string } = {
	html = "text/html; charset=utf-8", htm = "text/html; charset=utf-8", css = "text/css", js = "text/javascript",
	mjs = "text/javascript", json = "application/json", txt = "text/plain; charset=utf-8", md = "text/markdown; charset=utf-8",
	svg = "image/svg+xml", png = "image/png", jpg = "image/jpeg", jpeg = "image/jpeg", gif = "image/gif", webp = "image/webp",
	ico = "image/x-icon", wasm = "application/wasm", pdf = "application/pdf", xml = "application/xml", csv = "text/csv",
	zip = "application/zip", gz = "application/gzip", mp3 = "audio/mpeg", mp4 = "video/mp4", woff2 = "font/woff2",
}

// Whether `file` really is under `directory` once symbolic links are
// followed: a link inside the directory may lead out of it.
const Inside = function(file: string, directory: string): boolean {
	const rootFound, root = pcall(fs.realpath, directory)
	const fileFound, real = pcall(fs.realpath, file)
	if (!rootFound || !fileFound) {
		return false
	}
	const last = string.sub(root, -1)
	const prefix = if (last == "/" || last == "\\") root else root .. "/"
	const winPrefix = if (last == "/" || last == "\\") root else root .. "\\"
	return string.sub(real, 1, #prefix) == prefix || string.sub(real, 1, #winPrefix) == winPrefix
}

// A handler serving the files under `directory` (index.html for a
// directory); a path that would leave the directory is refused, a link
// leading out of it is not followed, and hidden files (a part starting with
// .) are not found.
const files = function(directory: string): Handler {
	return function(request: Request): Answer {
		if (request.method != "GET" && request.method != "HEAD") {
			return { status = 405, body = "Method Not Allowed" }
		}
		const parts: { string } = {}
		for (part in string.gmatch(request.params["*"] or request.path, "[^/\\]+")) {
			if (part == ".." || string.find(part, "[:%z]") != nil) {
				return { status = 403, body = "Forbidden" }
			}
			// Hidden files and directories (.git, .env) are not served.
			if (string.sub(part, 1, 1) == "." && part != ".") {
				return nil
			}
			if (part != ".") {
				table.insert(parts, part)
			}
		}
		let file = path.join(directory, table.unpack(parts))
		if (fs.isDir(file)) {
			file = path.join(file, "index.html")
		}
		if (!fs.isFile(file) || !Inside(file, directory)) {
			return nil
		}
		// Sent as it is read: a large file is never held whole.
		const opened, handle = pcall(fs.open, file)
		if (!opened) {
			return nil
		}
		const size = handle:seek(0, "end")
		handle:seek(0, "set")
		const extension = string.lower(string.match(file, "%.([^./\\]+)$") or "")
		return { status = 200, headers = { ["content-type"] = kTypes[extension] or "application/octet-stream" }, body = FileBody(handle, size) }
	}
}

return {
	serve = serve,
	router = router,
	files = files,
	upgrade = upgrade,
}
