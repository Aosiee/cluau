// cluau's package commands (cluau init, add, remove, install, update, list):
// dependencies from Git repositories, named in cluau.toml, pinned to exact
// commits in cluau.lock, and fetched into cluau_modules/<name>, where
// `require("name")` finds them. Git does the fetching, so `git` is needed
// on PATH.

const fs = require("@std/fs")
const path = require("@std/path")
const process = require("@std/process")
const io = require("@std/io")

const kProject = "cluau.toml"
const kLock = "cluau.lock"
const kModules = "cluau_modules"
const kMarker = ".cluau-commit"

type Value = string | number | boolean | { [string]: Value } | { Value }
type Table = { [string]: Value }

// A dependency as cluau.toml gives it, and as cluau.lock pins it.
type Dependency = { name: string, git: string, ref: string, kind: string }
type Locked = { name: string, git: string, ref: string, commit: string, via: string }

// What a failure puts back before cluau exits (cluau.toml as it was before
// an add that did not complete).
let undo: (() -> ())? = nil

function Fail(message: string): never {
	io.writeError(`cluau: {message}\n`)
	if (undo != nil) {
		const restore = undo
		undo = nil
		pcall(restore)
	}
	return process.exit(1)
}

function Say(message: string) {
	io.write(message, "\n")
}

// ---- TOML (the part of it cluau.toml uses) --------------------------------

// The error a value that goes on past its line raises: the next line is
// added and the value read again.
const kUnfinished = "an unfinished value"

function ParseString(text: string, at: number): (string, number) {
	const quote = string.sub(text, at, at)
	// """...""" and '''...''': a string that may run over several lines (a
	// line break straight after the opening quotes is not part of it).
	const triple = string.sub(text, at, at + 2) == string.rep(quote, 3)
	const out: { string } = {}
	let i = at + (if (triple) 3 else 1)
	if (triple && string.sub(text, i, i) == "\n") {
		i += 1
	}
	while (i <= #text) {
		const c = string.sub(text, i, i)
		if (triple && string.sub(text, i, i + 2) == string.rep(quote, 3)) {
			return table.concat(out), i + 3
		}
		if (!triple && c == quote) {
			return table.concat(out), i + 1
		}
		if (!triple && c == "\n") {
			break
		}
		if (c == "\\" && quote == "\"") {
			const e = string.sub(text, i + 1, i + 1)
			if (triple && string.find(e, "^%s") != nil) {
				// A backslash ending a line: the line break and the spaces after it go.
				i = string.find(text, "[^%s]", i + 1) or #text + 1
				continue
			}
			const escapes: { [string]: string } = { n = "\n", t = "\t", r = "\r", ["\\"] = "\\", ["\""] = "\"" }
			table.insert(out, escapes[e] or e)
			i += 2
		} else {
			table.insert(out, c)
			i += 1
		}
	}
	error(if (triple) kUnfinished else "an unterminated string", 0)
}

function SkipSpace(text: string, at: number): number {
	let i = at
	while (i <= #text && string.find(string.sub(text, i, i), "^[ \t]")) {
		i += 1
	}
	return i
}

// Spaces, line breaks and comments (between an array's values).
function SkipBlank(text: string, at: number): number {
	let i = at
	while (i <= #text) {
		const c = string.sub(text, i, i)
		if (c == "#") {
			i = string.find(text, "\n", i, true) or #text + 1
		} else if (string.find(c, "^%s") == nil) {
			break
		} else {
			i += 1
		}
	}
	return i
}

function ParseValue(text: string, at: number): (Value, number) {
	const i = SkipSpace(text, at)
	const c = string.sub(text, i, i)
	if (c == "\"" || c == "'") {
		return ParseString(text, i)
	}
	if (c == "[") {
		const array: { Value } = {}
		let j = i + 1
		while (true) {
			j = SkipBlank(text, j)
			if (j > #text) {
				error(kUnfinished, 0)
			}
			if (string.sub(text, j, j) == "]") {
				return array, j + 1
			}
			const value, after = ParseValue(text, j)
			table.insert(array, value)
			j = SkipBlank(text, after)
			if (j > #text) {
				error(kUnfinished, 0)
			}
			const d = string.sub(text, j, j)
			if (d == ",") {
				j += 1
			} else if (d != "]") {
				error("expected ',' or ']' in an array", 0)
			}
		}
	}
	if (c == "{") {
		const inline: Table = {}
		let j = SkipSpace(text, i + 1)
		if (string.sub(text, j, j) == "}") {
			return inline, j + 1
		}
		while (true) {
			j = SkipSpace(text, j)
			const key = string.match(text, "^[%w_%-]+", j)
			if (key == nil) {
				error("expected a key in an inline table", 0)
			}
			j = SkipSpace(text, j + #key)
			if (string.sub(text, j, j) != "=") {
				error(`expected '=' after {key}`, 0)
			}
			const value, after = ParseValue(text, j + 1)
			inline[key] = value
			j = SkipSpace(text, after)
			const d = string.sub(text, j, j)
			if (d == "}") {
				return inline, j + 1
			}
			if (d != ",") {
				error("expected ',' or '}' in an inline table", 0)
			}
			j += 1
		}
	}
	// A date or a time (1979-05-27, 07:32:00, 1979-05-27T07:32:00Z): kept as
	// its text.
	const date = string.match(text, "^%d%d%d%d%-%d%d%-%d%d[T ]%d%d:%d%d[%d:%.]*[Z%d:+%-]*", i)
		or string.match(text, "^%d%d%d%d%-%d%d%-%d%d", i) or string.match(text, "^%d%d:%d%d:%d%d[%d%.]*", i)
	if (date != nil) {
		return date, i + #date
	}
	const word = string.match(text, "^[%w_%.%-+]+", i)
	if (word == "true" || word == "false") {
		return word == "true", i + #word
	}
	const number = if (word != nil) tonumber((string.gsub(word, "_", ""))) else nil
	if (word != nil && number != nil) {
		return number, i + #word
	}
	error("expected a value (a string, a number, true, false, [ ... ] or { ... })", 0)
}

// The file's tables: { [section] = { key = value } } ("" for keys before
// any [section]). `file` names it in a problem.
function ParseToml(text: string, file: string): { [string]: Table } {
	const tables: { [string]: Table } = { [""] = {} }
	const lines = string.split(text, "\n")
	let current = ""
	let n = 1
	while (n <= #lines) {
		const number = n
		local function problem(message: string): never {
			return Fail(`{file}:{number}: {message}`)
		}
		const stripped = string.gsub(lines[n], "\r$", "")
		n += 1
		const body = string.match(stripped, "^%s*(.-)%s*$") or ""
		if (body == "" || string.sub(body, 1, 1) == "#") {
			continue
		}
		const header = string.match(body, "^%[%s*([%w_%.%-]+)%s*%]%s*#?.*$")
		if (header != nil) {
			current = header
			tables[current] = tables[current] or {}
			continue
		}
		if (string.find(body, "^%[%[") != nil) {
			// An array of tables ([[name]]): nothing cluau reads.
			current = "[[]]"
			tables[current] = {}
			continue
		}
		const key, rest = string.match(body, "^([%w_%-%.\"']+)%s*=%s*(.*)$")
		if (key == nil || rest == nil) {
			problem("expected `key = value` or `[section]`")
		}
		const name = string.gsub(key, "[\"']", "")
		// A value may go on over the next lines (an array, a """string""").
		let source = rest :: string
		let ok, value, after = pcall(ParseValue, source, 1)
		while (!ok && value == kUnfinished && n <= #lines) {
			source = source .. "\n" .. string.gsub(lines[n], "\r$", "")
			n += 1
			ok, value, after = pcall(ParseValue, source, 1)
		}
		if (!ok) {
			problem(if (value == kUnfinished) "a value with no end" else tostring(value))
		}
		const trailing = string.match(string.sub(source, after :: number), "^%s*(.-)$") or ""
		if (trailing != "" && string.sub(trailing, 1, 1) != "#") {
			problem(`unexpected text after the value: {trailing}`)
		}
		tables[current][name] = value :: Value
	}
	return tables
}

function Quote(text: string): string {
	return "\"" .. string.gsub(string.gsub(text, "\\", "\\\\"), "\"", "\\\"") .. "\""
}

// ---- the project -------------------------------------------------------

// The directory holding cluau.toml: the working directory or one above it.
function FindProject(): string? {
	let dir = process.cwd()
	while (true) {
		if (fs.isFile(path.join(dir, kProject))) {
			return dir
		}
		const parent = path.dirname(dir)
		if (parent == dir || parent == "") {
			return nil
		}
		dir = parent
	}
}

function RequireProject(): string {
	return FindProject() or Fail(`no {kProject} here or above (cluau init makes one)`)
}

// A repository address: `github.com/a/b` is https://github.com/a/b; a URL,
// an scp-style address (git@host:a/b) or a local path is as written.
function GitUrl(given: string): string {
	if (string.find(given, "://", 1, true) || string.find(given, "^[%w_.-]+@[%w_.-]+:") || fs.exists(given)) {
		return if (fs.exists(given)) path.absolute(given) else given
	}
	if (string.find(given, "^[%w.-]+%.[%a]+/")) {
		return `https://{given}`
	}
	return given
}

// A name a package may have: letters, digits, - and _ (it is a directory
// in cluau_modules, a key in cluau.toml and what require() is given).
function IsName(name: string): boolean {
	return string.find(name, "^[%w_%-]+$") != nil
}

// The name a repository's package gets: the last part of its address, with
// what a name may not hold made a -.
function DefaultName(url: string): string {
	const trimmed = string.gsub(url, "[/\\]+$", "")
	let last = string.match(trimmed, "([^/\\:]+)$") or trimmed
	last = string.gsub(last, "%.git$", "")
	last = string.gsub(last, "[^%w_%-]+", "-")
	last = string.gsub(string.gsub(last, "^%-+", ""), "%-+$", "")
	return last
}

// A repository address or a ref that git would read as an option.
function CheckArgument(what: string, value: string, where: string) {
	if (string.sub(value, 1, 1) == "-") {
		Fail(`{where}: {what} '{value}' starts with '-'`)
	}
}

// The dependencies a cluau.toml names; `shown` names the file in a problem.
function Dependencies(project: string, shown: string): { Dependency } {
	const file = path.join(project, kProject)
	const tables = ParseToml(fs.read(file), shown)
	const out: { Dependency } = {}
	for (name, spec in tables.dependencies or {}) {
		if (!IsName(name)) {
			Fail(`{shown}: '{name}' is not a package name (letters, digits, - and _)`)
		}
		if (type(spec) != "table") {
			Fail(`{shown}: dependencies.{name} is \{ git = "...", tag = "..." }`)
		}
		const t = spec :: Table
		const git = t.git
		if (type(git) != "string") {
			Fail(`{shown}: dependencies.{name} needs git = "<repository>"`)
		}
		CheckArgument("the repository", git :: string, `{shown}: dependencies.{name}`)
		let ref = "HEAD"
		let kind = "head"
		for (_, k in { "tag", "branch", "rev" }) {
			if (type(t[k]) == "string") {
				ref = t[k] :: string
				kind = k
			}
		}
		CheckArgument(`the {kind}`, ref, `{shown}: dependencies.{name}`)
		table.insert(out, { name = name, git = git :: string, ref = ref, kind = kind })
	}
	table.sort(out, function(a: Dependency, b: Dependency): boolean {
		return a.name < b.name
	})
	return out
}

function ReadLock(project: string): { [string]: Locked } {
	const file = path.join(project, kLock)
	const out: { [string]: Locked } = {}
	if (!fs.isFile(file)) {
		return out
	}
	for (name, t in ParseToml(fs.read(file), kLock)) {
		if (name != "") {
			out[name] = {
				name = name,
				git = tostring(t.git or ""),
				ref = tostring(t.ref or "HEAD"),
				commit = tostring(t.commit or ""),
				via = tostring(t.via or ""),
			}
		}
	}
	return out
}

function WriteLock(project: string, locked: { [string]: Locked }) {
	const names: { string } = {}
	for (name in locked) {
		table.insert(names, name)
	}
	table.sort(names)
	const lines = { "# cluau.lock: the exact commits `cluau install` fetches. Written by cluau; commit it with the project.", "" }
	for (_, name in names) {
		const l = locked[name]
		table.insert(lines, `[{name}]`)
		table.insert(lines, `git = {Quote(l.git)}`)
		table.insert(lines, `ref = {Quote(l.ref)}`)
		table.insert(lines, `commit = {Quote(l.commit)}`)
		if (l.via != "") {
			table.insert(lines, `via = {Quote(l.via)}`)
		}
		table.insert(lines, "")
	}
	fs.write(path.join(project, kLock), table.concat(lines, "\n"))
}

// cluau.toml with `name`'s dependency line set (`spec`) or removed (nil):
// the rest of the file, comments included, stays as it is.
function EditDependency(project: string, name: string, spec: string?) {
	const file = path.join(project, kProject)
	const lines: { string } = {}
	for (line in string.gmatch(fs.read(file) .. "\n", "([^\n]*)\n")) {
		table.insert(lines, (string.gsub(line, "\r$", "")))
	}
	while (#lines > 0 && lines[#lines] == "") {
		table.remove(lines)
	}
	let section = ""
	let header = 0
	let last = 0
	let found = 0
	for (i, line in lines) {
		const h = string.match(line, "^%s*%[%s*([%w_%.%-]+)%s*%]")
		if (h != nil) {
			section = h
			if (h == "dependencies") {
				header = i
				last = i
			}
		} else if (section == "dependencies") {
			const key = string.match(line, "^%s*\"?([%w_%-]+)\"?%s*=")
			if (key != nil) {
				last = i
				if (key == name) {
					found = i
				}
			}
		}
	}
	const entry = if (spec != nil) `{name} = {spec}` else nil
	if (found > 0) {
		if (entry != nil) {
			lines[found] = entry
		} else {
			table.remove(lines, found)
		}
	} else if (entry != nil) {
		if (header == 0) {
			table.insert(lines, "")
			table.insert(lines, "[dependencies]")
			table.insert(lines, entry)
		} else {
			table.insert(lines, last + 1, entry)
		}
	}
	fs.write(file, table.concat(lines, "\n") .. "\n")
}

// ---- git -----------------------------------------------------------------

function Git(args: { string }, cwd: string?): (boolean, string) {
	const command = { "git" }
	for (_, a in args) {
		table.insert(command, a)
	}
	// No prompts (a private or missing repository fails instead of waiting).
	const ok, result = pcall(process.run, command, { cwd = cwd, stderr = "capture", env = { GIT_TERMINAL_PROMPT = "0" } })
	if (!ok) {
		Fail("cannot run git (it fetches packages): is it installed and on PATH?")
	}
	const r = result :: { code: number, output: string, error: string }
	if (r.code != 0) {
		return false, (string.gsub(r.error, "%s+$", ""))
	}
	return true, r.output
}

function IsCommit(ref: string): boolean {
	return #ref == 40 && string.find(ref, "^%x+$") != nil
}

// The start of a commit's id (at least 7 of its digits).
function IsShortCommit(ref: string): boolean {
	return #ref >= 7 && #ref < 40 && string.find(ref, "^%x+$") != nil
}

// The commit a short id names in `url`: its branches and tags fetched into
// a scratch repository, and the id looked up there.
function ResolveShort(url: string, ref: string): string? {
	const scratch = fs.tempFile("cluau-resolve-")
	fs.remove(scratch)
	fs.mkdir(scratch)
	let commit: string? = nil
	let ok = Git({ "init", "--quiet" }, scratch)
	if (ok) {
		ok = Git({ "fetch", "--quiet", "--", url, "+refs/heads/*:refs/remotes/origin/*", "+refs/tags/*:refs/tags/*" }, scratch)
	}
	if (ok) {
		const found, output = Git({ "rev-parse", "--verify", "--quiet", "--end-of-options", ref .. "^{commit}" }, scratch)
		const full = string.match(output, "^%x+")
		if (found && full != nil && IsCommit(full) && string.sub(full, 1, #ref) == string.lower(ref)) {
			commit = full
		}
	}
	fs.remove(scratch, true)
	return commit
}

// The refs `url` has (refs/tags/v1.0, refs/heads/main, HEAD) and their commits.
function RemoteRefs(url: string): { [string]: string } {
	const ok, output = Git({ "ls-remote", "--", url })
	if (!ok) {
		return Fail(`cannot reach {url}: {output}`)
	}
	const refs: { [string]: string } = {}
	for (commit, name in string.gmatch(output, "(%x+)%s+([^\r\n]+)")) {
		refs[name] = commit
	}
	return refs
}

// The commit `ref` (a tag, a branch, a commit, or HEAD) names in `url`.
function Resolve(url: string, ref: string): string {
	if (IsCommit(ref)) {
		return string.lower(ref)
	}
	const refs = RemoteRefs(url)
	for (_, name in { "refs/tags/" .. ref .. "^{}", "refs/tags/" .. ref, "refs/heads/" .. ref, ref }) {
		if (refs[name] != nil) {
			return refs[name]
		}
	}
	if (IsShortCommit(ref)) {
		const commit = ResolveShort(url, ref)
		if (commit != nil) {
			return commit
		}
	}
	return Fail(`{url} has no tag, branch or commit '{ref}'`)
}

// The newest tag that reads as a version (v1.2.3), or nil.
function LatestTag(url: string): string? {
	const ok, output = Git({ "ls-remote", "--tags", "--", url })
	if (!ok) {
		return Fail(`cannot reach {url}: {output}`)
	}
	let best: string? = nil
	let bestKey: { number } = {}
	for (name in string.gmatch(output, "refs/tags/([^\r\n%^]+)")) {
		const a, b, c = string.match(name, "^v?(%d+)%.(%d+)%.?(%d*)$")
		if (a != nil) {
			const key = { tonumber(a) or 0, tonumber(b) or 0, tonumber(c) or 0 }
			let newer = best == nil
			for (k = 1, 3) {
				if (!newer && key[k] != bestKey[k]) {
					newer = key[k] > bestKey[k]
					break
				}
			}
			if (newer) {
				best = name
				bestKey = key
			}
		}
	}
	return best
}

// `commit` of `url` into cluau_modules/<name> (unless it is there already).
function Fetch(project: string, name: string, url: string, commit: string): boolean {
	if (!IsCommit(commit)) {
		return Fail(`{kLock}: {name}'s commit '{commit}' is not a commit id`)
	}
	const target = path.join(project, kModules, name)
	const marker = path.join(target, kMarker)
	if (fs.isFile(marker) && string.match(fs.read(marker), "%x+") == commit) {
		return false
	}
	const scratch = path.join(project, kModules, `.{name}.fetching`)
	fs.remove(scratch, true)
	fs.mkdir(scratch)
	let ok, problem = Git({ "init", "--quiet" }, scratch)
	if (ok) {
		ok, problem = Git({ "fetch", "--quiet", "--depth", "1", "--", url, commit }, scratch)
		if (!ok) {
			// A server that does not serve single commits: all of it.
			ok, problem = Git({ "fetch", "--quiet", "--", url }, scratch)
		}
	}
	if (ok) {
		ok, problem = Git({ "-c", "advice.detachedHead=false", "checkout", "--quiet", "--detach", commit }, scratch)
	}
	if (!ok) {
		fs.remove(scratch, true)
		return Fail(`cannot fetch {name} ({url} at {string.sub(commit, 1, 12)}): {problem}`)
	}
	fs.remove(path.join(scratch, ".git"), true)
	fs.write(path.join(scratch, kMarker), commit .. "\n")
	fs.remove(target, true)
	fs.rename(scratch, target)
	return true
}

// ---- the commands ---------------------------------------------------------

// Every dependency (and theirs, flattened) fetched at its locked commit, or a
// newly resolved one where the lock has none (or `fresh` names it).
function Install(project: string, fresh: { [string]: boolean }) {
	const lock = ReadLock(project)
	const chosen: { [string]: Locked } = {}
	const queue: { { dep: Dependency, via: string } } = {}
	for (_, dep in Dependencies(project, kProject)) {
		table.insert(queue, { dep = dep, via = "" })
	}
	let fetched = 0
	let at = 1
	while (at <= #queue) {
		const item = queue[at]
		at += 1
		const dep = item.dep
		const previous = chosen[dep.name]
		if (previous != nil) {
			if (previous.git != dep.git || previous.ref != dep.ref) {
				const first = if (previous.via == "") "the project" else previous.via
				const second = if (item.via == "") "the project" else item.via
				Fail(`{dep.name} is wanted at two places: {previous.git} {previous.ref} (by {first}) and {dep.git} {dep.ref} (by {second})`)
			}
			continue
		}
		const locked = lock[dep.name]
		let commit = ""
		if (locked != nil && locked.git == dep.git && locked.ref == dep.ref && IsCommit(locked.commit) && !fresh[dep.name] && !fresh["*"]) {
			commit = locked.commit
		} else {
			commit = Resolve(dep.git, dep.ref)
		}
		chosen[dep.name] = { name = dep.name, git = dep.git, ref = dep.ref, commit = commit, via = item.via }
		if (Fetch(project, dep.name, dep.git, commit)) {
			fetched += 1
			Say(`  {dep.name} {if (dep.ref == "HEAD") "" else dep.ref .. " "}({string.sub(commit, 1, 12)})`)
		}
		// Its own dependencies, beside it.
		const own = path.join(project, kModules, dep.name)
		if (fs.isFile(path.join(own, kProject))) {
			for (_, inner in Dependencies(own, `{kModules}/{dep.name}/{kProject}`)) {
				table.insert(queue, { dep = inner, via = dep.name })
			}
		}
	}
	// What is no longer wanted goes.
	const modules = path.join(project, kModules)
	if (fs.isDir(modules)) {
		for (_, name in fs.list(modules)) {
			if (chosen[name] == nil && fs.isFile(path.join(modules, name, kMarker))) {
				fs.remove(path.join(modules, name), true)
				Say(`  removed {name}`)
			}
		}
	}
	WriteLock(project, chosen)
	let count = 0
	for (_ in chosen) {
		count += 1
	}
	Say(`{count} package(s) in {kModules}{if (fetched > 0) `, {fetched} fetched` else ""}`)
}

function Init(args: { string }) {
	const dir = process.cwd()
	if (fs.exists(path.join(dir, kProject))) {
		Fail(`{kProject} is here already`)
	}
	const name = args[1] or path.basename(dir)
	fs.write(path.join(dir, kProject), `[package]\nname = {Quote(name)}\nversion = "0.1.0"\n\n[dependencies]\n`)
	Say(`made {kProject} for {name}`)
	const ignore = path.join(dir, ".gitignore")
	if (!fs.exists(ignore)) {
		fs.write(ignore, `{kModules}/\n`)
		Say(`made .gitignore (leaving {kModules}/ out of Git)`)
	}
}

function Add(args: { string }) {
	const project = RequireProject()
	let given: string? = nil
	let name: string? = nil
	let i = 1
	while (i <= #args) {
		if (args[i] == "--name") {
			name = args[i + 1] or Fail("--name needs a name")
			i += 2
		} else {
			given = args[i]
			i += 1
		}
	}
	if (given == nil) {
		return Fail("usage: cluau add <repository>[@tag|@branch|@commit] [--name <name>]")
	}
	// repository@ref: the @ is looked for in the address's path, past a
	// user's (git@host:a/b, ssh://git@host/a/b, https://token@host/a/b).
	let address = given
	let ref: string? = nil
	let pathAt = 1
	const authority = string.match(given, "^%a[%w+.-]*://()")
	if (authority != nil) {
		pathAt = string.find(given, "/", authority, true) or #given + 1
	} else {
		pathAt = string.match(given, "^[%w_.-]+@[%w_.-]+:()") or 1
	}
	const at = string.match(string.sub(given, pathAt), "^.*()@")
	if (at != nil && pathAt + at - 1 > 1) {
		address = string.sub(given, 1, pathAt + at - 2)
		ref = string.sub(given, pathAt + at)
		if (ref == "") {
			Fail(`'{given}' ends in @ with no tag, branch or commit after it`)
		}
	}
	const url = GitUrl(address)
	CheckArgument("the repository", url, "cluau add")
	if (ref != nil) {
		CheckArgument("the ref", ref, "cluau add")
	}
	const package = name or DefaultName(url)
	if (!IsName(package)) {
		Fail(if (name != nil) `'{package}' is not a package name (letters, digits, - and _)`
			else `no package name comes from '{url}': give one with --name`)
	}
	if (ref == nil) {
		ref = LatestTag(url) or "HEAD"
	}
	const wanted = ref :: string
	let spec: string
	if (wanted == "HEAD") {
		spec = "{ git = " .. Quote(url) .. " }"
	} else if (IsCommit(wanted)) {
		spec = "{ git = " .. Quote(url) .. ", rev = " .. Quote(string.lower(wanted)) .. " }"
	} else {
		const refs = RemoteRefs(url)
		if (refs["refs/tags/" .. wanted] != nil) {
			spec = "{ git = " .. Quote(url) .. ", tag = " .. Quote(wanted) .. " }"
		} else if (refs["refs/heads/" .. wanted] != nil || refs[wanted] != nil) {
			spec = "{ git = " .. Quote(url) .. ", branch = " .. Quote(wanted) .. " }"
		} else {
			// A commit's short id: pinned as the whole id.
			spec = "{ git = " .. Quote(url) .. ", rev = " .. Quote(Resolve(url, wanted)) .. " }"
		}
	}
	// cluau.toml goes back to what it was if the install fails.
	const file = path.join(project, kProject)
	const before = fs.read(file)
	undo = function() {
		fs.write(file, before)
		io.writeError(`cluau: {kProject} is left as it was\n`)
	}
	EditDependency(project, package, spec)
	Say(`added {package} ({url}{if (wanted != "HEAD") " " .. wanted else ""}) to {kProject}`)
	const installed, problem = pcall(Install, project, { [package] = true })
	const restore = undo
	undo = nil
	if (!installed) {
		if (restore != nil) {
			restore()
		}
		error(problem, 0)
	}
}

function Remove(args: { string }) {
	const project = RequireProject()
	const name = args[1] or Fail("usage: cluau remove <name>")
	let known = false
	for (_, dep in Dependencies(project, kProject)) {
		known = known || dep.name == name
	}
	if (!known) {
		Fail(`{name} is not a dependency in {kProject}`)
	}
	EditDependency(project, name, nil)
	Say(`removed {name} from {kProject}`)
	Install(project, {})
}

function Update(args: { string }) {
	const project = RequireProject()
	const fresh: { [string]: boolean } = {}
	if (#args == 0) {
		fresh["*"] = true
	}
	for (_, name in args) {
		fresh[name] = true
	}
	Install(project, fresh)
}

function List() {
	const project = RequireProject()
	const lock = ReadLock(project)
	const names: { string } = {}
	for (name in lock) {
		table.insert(names, name)
	}
	table.sort(names)
	if (#names == 0) {
		Say("no packages (cluau add <repository> adds one)")
		return
	}
	for (_, name in names) {
		const l = lock[name]
		const ref = if (l.ref == "HEAD") "" else ` {l.ref}`
		const via = if (l.via == "") "" else ` (for {l.via})`
		const here = if (fs.isFile(path.join(project, kModules, name, kMarker))) "" else " (not installed: cluau install)"
		Say(`{name}{ref} {string.sub(l.commit, 1, 12)} {l.git}{via}{here}`)
	}
}

// `cluau <command> args...`.
function main(args: { string }) {
	const command = args[1]
	const rest: { string } = {}
	for (i = 2, #args) {
		table.insert(rest, args[i])
	}
	if (command == "init") {
		Init(rest)
	} else if (command == "add") {
		Add(rest)
	} else if (command == "remove") {
		Remove(rest)
	} else if (command == "install") {
		Install(RequireProject(), {})
	} else if (command == "update") {
		Update(rest)
	} else if (command == "list") {
		List()
	} else {
		Fail(`unknown package command '{tostring(command)}'`)
	}
}

return { main = main }
