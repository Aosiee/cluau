// @std/websocket: WebSocket connections (RFC 6455) over @std/net: a client
// (websocket.connect, ws:// and wss://), and the connections @std/server
// accepts. Messages are text or binary; fragmented ones arrive joined,
// pings are answered, and closing is the protocol's handshake. Each wait
// waits on its own in a task.
//
//   const websocket = require("@std/websocket")
//   const ws = websocket.connect("wss://echo.example.org/chat")
//   ws:send("hello")
//   const reply = ws:receive()
//   if (reply != nil) { print(reply.data) }
//   ws:close()

const net = require("@std/net")
const encoding = require("@std/encoding")

// @std/crypto, loaded by the first connection: a build without it still
// loads this module (and @std/server, which serves plain HTTP without it),
// and a connection is an error saying why.
const Crypto = function() {
	const found, crypto = pcall(require, "@std/crypto")
	if (!found) {
		error("websocket: this cluau is built without @std/crypto, which WebSockets need", 0)
	}
	return crypto
}

export type Kind = "text" | "binary"
export type Message = { kind: Kind, data: string }
export type ConnectOptions = {
	headers: { [string]: string }?,
	protocols: { string }?,
	timeout: number?,
	caFile: string?,
	verify: boolean?,
}

const kGuid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
const kText = 1
const kBinary = 2
const kClose = 8
const kPing = 9
const kPong = 10
// The most a message may have, its fragments together, and the most
// fragments it may come in.
const kMaxMessage = 64 * 1024 * 1024
const kMaxFragments = 65536
// The most the handshake's answer may have: a line, and the whole head.
const kLineLimit = 64 * 1024
const kHeadLimit = 256 * 1024

// The close codes an endpoint may send (RFC 6455 7.4): 1004 is reserved,
// and 1005, 1006 and 1015 stand for a close without a code.
const SendableCode = function(code: number): boolean {
	return (code >= 1000 && code <= 1003) || (code >= 1007 && code <= 1014) || (code >= 3000 && code <= 4999)
}

// An HTTP token (a header's name, a subprotocol's).
const IsToken = function(text: string): boolean {
	return string.find(text, "^[%w!#$%%&'*+%-.^_`|~]+$") != nil
}

// Whether text is UTF-8 (as a text message must be): no bad sequences, and
// no UTF-16 surrogates (U+D800 to U+DFFF).
const IsUtf8 = function(text: string): boolean {
	return utf8.len(text) != nil && string.find(text, "\237[\160-\191]") == nil
}

// What the handshake's key answers: base64(SHA-1(key .. the GUID)).
const Accept = function(key: string): string {
	return encoding.toBase64(Crypto().hash("sha1", key .. kGuid, { raw = true }))
}


// The payload XORed with the 4-byte key (masking and unmasking alike), four
// bytes at a time.
const Mask = function(payload: string, key: string): string {
	const data = buffer.fromstring(payload)
	const n = #payload
	const word = buffer.readu32(buffer.fromstring(key), 0)
	const whole = n - n % 4
	for (i = 0, whole - 4, 4) {
		buffer.writeu32(data, i, bit32.bxor(buffer.readu32(data, i), word))
	}
	const k = { string.byte(key, 1, 4) }
	for (i = whole, n - 1) {
		buffer.writeu8(data, i, bit32.bxor(buffer.readu8(data, i), k[i % 4 + 1]))
	}
	return buffer.tostring(data)
}

const Frame = function(opcode: number, payload: string, masked: boolean): string {
	const length = #payload
	const maskBit = if (masked) 128 else 0
	let header: string
	if (length < 126) {
		header = string.char(128 + opcode, maskBit + length)
	} else if (length < 65536) {
		header = string.char(128 + opcode, maskBit + 126, bit32.rshift(length, 8), bit32.band(length, 255))
	} else {
		const high = math.floor(length / 4294967296)
		const low = length % 4294967296
		header = string.char(128 + opcode, maskBit + 127) .. string.pack(">I4I4", high, low)
	}
	if (!masked) {
		return header .. payload
	}
	const key = Crypto().randomBytes(4)
	return header .. key .. Mask(payload, key)
}

class Connection {
	Socket: net.Socket = nil :: any // allow-any: given by the constructor
	Client: boolean = true
	Closed: boolean = false
	// The protocol the server chose (""), and the close's code and reason.
	protocol: string = ""
	closeCode: number = 0
	closeReason: string = ""
	// Read from the socket and not yet taken (from At on): the socket is
	// read a chunk at a time, not once for each part of each frame.
	Pending: string = ""
	At: number = 1

	function Init(socket: net.Socket, client: boolean) {
		self.Socket = socket
		self.Client = client
	}

	// Exactly `count` bytes (nil when the connection ends first).
	function ReadExact(count: number): string? {
		const have = #self.Pending - self.At + 1
		if (have >= count) {
			const taken = string.sub(self.Pending, self.At, self.At + count - 1)
			self.At += count
			return taken
		}
		const parts: { string } = { string.sub(self.Pending, self.At) }
		let need = count - have
		self.Pending = ""
		self.At = 1
		while (need > 0) {
			const chunk = self.Socket:read(math.max(need, 65536))
			if (chunk == nil) {
				return nil
			}
			if (#chunk > need) {
				table.insert(parts, string.sub(chunk, 1, need))
				self.Pending = chunk
				self.At = need + 1
				need = 0
			} else {
				table.insert(parts, chunk)
				need -= #chunk
			}
		}
		return table.concat(parts)
	}

	function Send(opcode: number, payload: string) {
		if (self.Closed) {
			error("websocket: the connection is closed", 3)
		}
		self.Socket:write(Frame(opcode, payload, self.Client))
	}

	// Sends a text message.
	function send(text: string) {
		self:Send(kText, text)
	}

	// Sends a binary message (a string of the bytes, or a buffer).
	function sendBinary(data: string | buffer) {
		self:Send(kBinary, if (type(data) == "buffer") buffer.tostring(data) else data :: string)
	}

	// Sends a ping (its data at most 125 bytes, as a control frame's is).
	function ping(data: string?) {
		const payload = data or ""
		if (#payload > 125) {
			error(`websocket: a ping's data is at most 125 bytes, not {#payload}`, 2)
		}
		self:Send(kPing, payload)
	}

	// The other side broke the protocol: the close frame with `code` (1002,
	// a protocol error; 1007, text that is not UTF-8; 1009, too big), and
	// the connection ends.
	function Fault(code: number, reason: string) {
		if (!self.Closed) {
			self.Closed = true
			pcall(function() {
				self.Socket:write(Frame(kClose, string.pack(">I2", code) .. reason, self.Client))
			})
		}
		self.closeCode = code
		self.closeReason = reason
		pcall(function() {
			self.Socket:close()
		})
	}

	// One frame: its opcode, whether it ends a message, its payload (nil
	// when the connection ended, cut short or broken). A data frame may have
	// at most `room` bytes.
	function ReadFrame(room: number): (number?, boolean, string) {
		const head = self:ReadExact(2)
		if (head == nil) {
			return nil, true, ""
		}
		const b0, b1 = string.byte(head, 1, 2)
		const fin = bit32.band(b0, 128) != 0
		const opcode = bit32.band(b0, 15)
		const masked = bit32.band(b1, 128) != 0
		let length = bit32.band(b1, 127)
		if (bit32.band(b0, 112) != 0) {
			self:Fault(1002, "reserved bits set with no extension")
			return nil, true, ""
		}
		if ((opcode > kBinary && opcode < kClose) || opcode > kPong) {
			self:Fault(1002, `reserved opcode {opcode}`)
			return nil, true, ""
		}
		// A client masks what it sends; a server does not.
		if (masked == self.Client) {
			self:Fault(1002, if (masked) "a masked frame from the server" else "an unmasked frame from the client")
			return nil, true, ""
		}
		if (opcode >= kClose && (length > 125 || !fin)) {
			self:Fault(1002, "a control frame of more than 125 bytes, or fragmented")
			return nil, true, ""
		}
		if (length == 126) {
			const extended = self:ReadExact(2)
			if (extended == nil) {
				return nil, true, ""
			}
			length = string.unpack(">I2", extended)
		} else if (length == 127) {
			const extended = self:ReadExact(8)
			if (extended == nil) {
				return nil, true, ""
			}
			const high, low = string.unpack(">I4I4", extended)
			if (high >= 2147483648) {
				self:Fault(1002, "a frame's length has its top bit set")
				return nil, true, ""
			}
			length = high * 4294967296 + low
		}
		if (opcode < kClose && length > room) {
			self:Fault(1009, `a message of more than {kMaxMessage} bytes`)
			return nil, true, ""
		}
		const key = if (masked) self:ReadExact(4) else ""
		const payload = self:ReadExact(length)
		if (key == nil || payload == nil) {
			return nil, true, ""
		}
		return opcode, fin, if (masked) Mask(payload, key) else payload
	}

	// The next message (nil once the connection has closed): its kind and
	// data. Pings are answered on the way.
	function receive(): Message? {
		if (self.Closed) {
			return nil
		}
		let kind: Kind? = nil // the message under way, once its first frame came
		const parts: { string } = {}
		let size = 0
		let fragments = 0
		while (true) {
			const opcode, fin, payload = self:ReadFrame(kMaxMessage - size)
			if (opcode == nil) {
				self.Closed = true
				pcall(function() {
					self.Socket:close()
				})
				return nil
			}
			if (opcode == kPing) {
				self.Socket:write(Frame(kPong, payload, self.Client))
			} else if (opcode == kPong) {
				// an answer to our ping: nothing to do
			} else if (opcode == kClose) {
				if (#payload == 1) {
					self:Fault(1002, "a close frame of one byte")
					return nil
				}
				if (#payload >= 2) {
					const code = string.unpack(">I2", payload)
					if (!SendableCode(code)) {
						self:Fault(1002, `a close with the code {code}`)
						return nil
					}
					if (!IsUtf8(string.sub(payload, 3))) {
						self:Fault(1007, "a close reason that is not UTF-8")
						return nil
					}
					self.closeCode = code
					self.closeReason = string.sub(payload, 3)
				}
				if (!self.Closed) {
					self.Closed = true
					pcall(function() {
						self.Socket:write(Frame(kClose, string.sub(payload, 1, 2), self.Client))
					})
				}
				self.Socket:close()
				return nil
			} else {
				// A message's first frame is text or binary; the rest continue it.
				if ((opcode == 0) != (kind != nil)) {
					self:Fault(1002, if (opcode == 0) "a continuation with no message to continue" else "a new message inside a fragmented one")
					return nil
				}
				if (kind == nil) {
					kind = if (opcode == kBinary) "binary" else "text"
				}
				// Empty fragments add nothing, but are counted.
				fragments += 1
				if (fragments > kMaxFragments) {
					self:Fault(1009, `a message in more than {kMaxFragments} fragments`)
					return nil
				}
				if (payload != "") {
					table.insert(parts, payload)
				}
				size += #payload
				if (fin) {
					const data = table.concat(parts)
					if (kind == "text" && !IsUtf8(data)) {
						self:Fault(1007, "a text message that is not UTF-8")
						return nil
					}
					return { kind = kind :: Kind, data = data }
				}
			}
		}
		return nil
	}

	// An iterator over the messages: for (message in ws:messages()) { }
	function messages(): () -> Message? {
		return function(): Message? {
			return self:receive()
		}
	}

	// Closes the connection: the close frame (with `code`, 1000 by default,
	// and `reason`), then the other side's (its code and reason in closeCode
	// and closeReason), then the socket.
	function close(code: number?, reason: string?) {
		if (self.Closed) {
			return
		}
		if (code != nil && (code != math.floor(code) || !SendableCode(code))) {
			error(`websocket: {code} is not a close code to send (1000 to 1003, 1007 to 1014, 3000 to 4999)`, 2)
		}
		if (!IsUtf8(reason or "")) {
			error("websocket: a close's reason is UTF-8", 2)
		}
		const payload = string.pack(">I2", code or 1000) .. (reason or "")
		if (#payload > 125) {
			error("websocket: a close's reason is at most 123 bytes", 2)
		}
		pcall(function() {
			self.Socket:write(Frame(kClose, payload, self.Client))
		})
		self.Closed = true
		// The other side's close, briefly waited for (two seconds in all).
		self.Socket:setDeadline(2)
		pcall(function() {
			while (true) {
				const opcode, _, payload = self:ReadFrame(kMaxMessage)
				if (opcode == nil) {
					break
				}
				if (opcode == kClose) {
					if (#payload >= 2) {
						self.closeCode = string.unpack(">I2", payload)
						self.closeReason = string.sub(payload, 3)
					}
					break
				}
			}
		})
		self.Socket:close()
	}
}

// A connection (its methods are send, sendBinary, ping, receive, messages
// and close).
export type WebSocket = Connection

// ws://host[:port]/path?query or wss://...: host, port, the target (the
// path and query, without a #fragment, which is not sent), TLS.
const ParseUrl = function(url: string): (string, number, string, boolean) {
	const scheme, rest = string.match(url, "^(wss?)://(.+)$")
	if (scheme == nil || rest == nil) {
		error(`websocket.connect: '{url}' is not a ws:// or wss:// address`, 3)
	}
	// Nothing in it may end the request line or a header early.
	if (string.find(url, "[%s%c]") != nil) {
		error(`websocket.connect: '{url}' has white space or a control character in it`, 3)
	}
	const tls = scheme == "wss"
	const authority = string.match(rest, "^[^/?#]+") or rest
	let target = string.match(string.sub(rest, #authority + 1), "^[^#]*") or ""
	if (target == "" || string.sub(target, 1, 1) == "?") {
		target = "/" .. target
	}
	let host = authority
	let port = if (tls) 443 else 80
	const bracketed, bracketPort = string.match(authority, "^%[(.+)%]:?(%d*)$")
	if (bracketed != nil) {
		host = bracketed
		if (bracketPort != nil && bracketPort != "") {
			port = tonumber(bracketPort) or port
		}
	} else {
		const name, number = string.match(authority, "^(.+):(%d+)$")
		if (name != nil) {
			host = name
			port = tonumber(number) or port
		}
	}
	return host, port, target, tls
}

// The handshake's answer: its status line and headers (names in lowercase,
// repeated ones joined), within the limits of a head.
const ReadAnswer = function(socket: net.Socket, url: string): (string, { [string]: string }) {
	const read, status, headers = pcall(function(): (string, { [string]: string }) {
		const first = socket:readLine(kLineLimit) or ""
		const found: { [string]: string } = {}
		let size = #first
		let count = 0
		while (true) {
			const line = socket:readLine(kLineLimit)
			if (line == nil || line == "") {
				break
			}
			size += #line + 2
			count += 1
			if (size > kHeadLimit || count > 100) {
				error("too long", 0)
			}
			const name, value = string.match(line, "^([^:]+):[ \t]*(.-)[ \t]*$")
			if (name != nil && value != nil) {
				const key = string.lower(name)
				found[key] = if (found[key] != nil) found[key] .. ", " .. value else value
			}
		}
		return first, found
	})
	if (!read) {
		socket:close()
		// The socket's own error, without where in this module it was raised.
		const why = string.gsub(tostring(status), "^@std/websocket:%d+: ", "")
		if (string.find(why, "longer than", 1, true) != nil || why == "too long") {
			error(`websocket.connect: {url} answered the handshake with a head of more than {kHeadLimit} bytes or 100 headers`, 3)
		}
		error(`websocket.connect: {url}: {why}`, 3)
	}
	return status :: string, headers :: { [string]: string }
}

// Whether a comma-separated header value has `token` (case aside).
const HasToken = function(value: string?, token: string): boolean {
	for (part in string.gmatch(string.lower(value or ""), "[^,]+")) {
		if (string.match(part, "^[ \t]*(.-)[ \t]*$") == token) {
			return true
		}
	}
	return false
}

// A connection to `url`: the handshake made and its answer checked.
// options.timeout limits the connecting and the handshake (not later waits).
const connect = function(url: string, options: ConnectOptions?): Connection {
	const given = options or {}
	const host, port, target, tls = ParseUrl(url)
	// What goes in the request is checked first: nothing may end a header.
	const extra: { string } = {}
	if (given.protocols != nil && #given.protocols > 0) {
		for (_, protocol in given.protocols) {
			if (type(protocol) != "string" || !IsToken(protocol)) {
				error(`websocket.connect: '{tostring(protocol)}' is not a protocol name`, 2)
			}
		}
		table.insert(extra, `Sec-WebSocket-Protocol: {table.concat(given.protocols, ", ")}`)
	}
	for (name, value in given.headers or {}) {
		if (type(name) != "string" || !IsToken(name)) {
			error(`websocket.connect: options.headers: '{tostring(name)}' is not a header name`, 2)
		}
		if ((type(value) != "string" && type(value) != "number") || string.find(tostring(value), "[\r\n%z]") != nil) {
			error(`websocket.connect: options.headers: the {name} header's value is text with no line break`, 2)
		}
		table.insert(extra, `{name}: {value}`)
	}
	const key = encoding.toBase64(Crypto().randomBytes(16))
	const socket = net.connect(host, port, { timeout = given.timeout, tls = tls, caFile = given.caFile, verify = given.verify })
	if (given.timeout != nil) {
		socket:setDeadline(given.timeout)
	}
	const lines: { string } = {
		`GET {target} HTTP/1.1`,
		`Host: {if (string.find(host, ":", 1, true) != nil) `[{host}]` else host}{if ((tls && port == 443) || (!tls && port == 80)) "" else ":" .. tostring(port)}`,
		"Upgrade: websocket",
		"Connection: Upgrade",
		`Sec-WebSocket-Key: {key}`,
		"Sec-WebSocket-Version: 13",
	}
	for (_, line in extra) {
		table.insert(lines, line)
	}
	socket:write(table.concat(lines, "\r\n"), "\r\n\r\n")
	const status, headers = ReadAnswer(socket, url)
	if (string.match(status, "^HTTP/1%.%d 101") == nil) {
		socket:close()
		error(`websocket.connect: {url} did not accept the connection ({status})`, 2)
	}
	if (!HasToken(headers["upgrade"], "websocket") || !HasToken(headers["connection"], "upgrade")) {
		socket:close()
		error(`websocket.connect: {url} answered 101 without Upgrade: websocket and Connection: Upgrade`, 2)
	}
	if (headers["sec-websocket-accept"] != Accept(key)) {
		socket:close()
		error(`websocket.connect: {url} answered the handshake wrongly`, 2)
	}
	// The protocol chosen is one of those offered (none when none were).
	const chosen = headers["sec-websocket-protocol"]
	if (chosen != nil) {
		let offered = false
		for (_, protocol in given.protocols or {}) {
			offered = offered || protocol == chosen
		}
		if (!offered) {
			socket:close()
			error(`websocket.connect: {url} chose the protocol '{chosen}', which was not offered`, 2)
		}
	}
	// The connection's waits have no limit from here: a quiet connection is
	// not a broken one.
	socket:setDeadline(nil)
	socket:setTimeout(0)
	const ws = Connection(socket, true)
	ws.protocol = chosen or ""
	return ws
}

return {
	connect = connect,
	// @std/server's: a connection it accepted (its handshake answered).
	_fromSocket = function(socket: net.Socket): Connection {
		return Connection(socket, false)
	},
	_accept = Accept,
}
