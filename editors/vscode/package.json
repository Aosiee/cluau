{
	"name": "cluau",
	"displayName": "cluau",
	"description": "cluau, C-syntax-flavoured Luau: highlighting, the checker's errors, completion, hover and navigation as you type, and the debugger.",
	"version": "0.28.0",
	"publisher": "aosiee",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "https://github.com/Aosiee/cluau"
	},
	"homepage": "https://github.com/Aosiee/cluau/tree/main/editors/vscode",
	"bugs": {
		"url": "https://github.com/Aosiee/cluau/issues"
	},
	"engines": {
		"vscode": "^1.82.0"
	},
	"categories": [
		"Programming Languages",
		"Debuggers",
		"Linters",
		"Formatters"
	],
	"keywords": [
		"cluau",
		"luau",
		"lua",
		"scripting"
	],
	"main": "./src/extension.js",
	"activationEvents": [
		"onDebugResolve:cluau",
		"onDebugDynamicConfigurations:cluau"
	],
	"contributes": {
		"languages": [
			{
				"id": "cluau",
				"aliases": [
					"cluau"
				],
				"extensions": [
					".cluau"
				],
				"firstLine": "^#!.*\\bcluau\\b",
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "cluau",
				"scopeName": "source.cluau",
				"path": "./syntaxes/cluau.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "cluau.run",
				"title": "Run File",
				"category": "cluau",
				"icon": "$(play)"
			},
			{
				"command": "cluau.debug",
				"title": "Debug File",
				"category": "cluau",
				"icon": "$(debug-alt)"
			},
			{
				"command": "cluau.restartServer",
				"title": "Restart Language Server",
				"category": "cluau"
			}
		],
		"menus": {
			"editor/title/run": [
				{
					"command": "cluau.run",
					"when": "resourceLangId == cluau"
				},
				{
					"command": "cluau.debug",
					"when": "resourceLangId == cluau"
				}
			],
			"commandPalette": [
				{
					"command": "cluau.run",
					"when": "editorLangId == cluau"
				},
				{
					"command": "cluau.debug",
					"when": "editorLangId == cluau"
				}
			]
		},
		"configuration": {
			"title": "cluau",
			"properties": {
				"cluau.path": {
					"type": "string",
					"default": "cluau",
					"markdownDescription": "The `cluau` program: a path (a relative one, or one with `${workspaceFolder}`, from the workspace folder), or a name found on `PATH` (0.17.0 or later)."
				},
				"cluau.modules": {
					"type": "object",
					"default": {},
					"additionalProperties": {
						"type": "string"
					},
					"markdownDescription": "A host's modules, typed from files: `{ \"@game/world\": \"types/world.luau\" }` (as `cluau check --module`). Paths are relative to the workspace folder."
				},
				"cluau.trace.server": {
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Logs the messages between the editor and the language server (in the cluau output channel)."
				}
			}
		},
		"breakpoints": [
			{
				"language": "cluau"
			}
		],
		"debuggers": [
			{
				"type": "cluau",
				"label": "cluau",
				"languages": [
					"cluau"
				],
				"configurationAttributes": {
					"launch": {
						"required": [
							"program"
						],
						"properties": {
							"program": {
								"type": "string",
								"default": "${file}",
								"description": "The script to run."
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"default": [],
								"description": "The script's arguments (process.args)."
							},
							"cwd": {
								"type": "string",
								"default": "${workspaceFolder}",
								"description": "The directory the script runs in (the script's own when not given)."
							},
							"stopOnEntry": {
								"type": "boolean",
								"default": false,
								"description": "Pause at the script's first line."
							},
							"sandbox": {
								"type": "boolean",
								"default": false,
								"description": "Run without file, network or process access (cluau --sandbox)."
							},
							"test": {
								"type": "boolean",
								"default": false,
								"description": "Run the program's @std/test cases, as cluau test does (the default for a *_test.cluau file)."
							},
							"filter": {
								"type": "string",
								"default": "",
								"description": "With test: only the cases whose names hold this text (cluau test -k)."
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "cluau",
						"request": "launch",
						"name": "Debug the current file",
						"program": "${file}"
					}
				],
				"configurationSnippets": [
					{
						"label": "cluau: Launch",
						"description": "Debug a cluau script.",
						"body": {
							"type": "cluau",
							"request": "launch",
							"name": "Debug ${1:script}",
							"program": "^\"\\${workspaceFolder}/${1:main.cluau}\""
						}
					}
				]
			}
		]
	},
	"scripts": {
		"test": "node test/grammar.js"
	},
	"dependencies": {
		"vscode-languageclient": "9.0.1"
	},
	"devDependencies": {
		"@vscode/vsce": "3.2.1",
		"ovsx": "0.10.1"
	}
}
