// cluau --sandbox
// @std/random: seeded generators give fixed sequences (the first values are
// xoshiro256** seeded through splitmix64, as its reference code gives
// them), and the mistakes are errors. It is pure, so the sandbox has it.
const random = require("@std/random")

// integer(0, 2^53 - 1) is the generator's top 53 bits, unchanged.
const Bits = function(seed: number): string {
	const rng = random.new(seed)
	const out: { string } = {}
	for (i = 1, 3) {
		table.insert(out, string.format("%d", rng:integer(0, 2 ^ 53 - 1)))
	}
	return table.concat(out, " ")
}
print(Bits(0))
print(Bits(-1))
print(Bits(2 ^ 62))
print(Bits(12345))
print(random.new(0):random() == 5415695640260286 / 2 ^ 53)

const rng = random.new(42)
print(rng:random(), rng:random(), rng:random())
const dice: { number } = {}
for (i = 1, 20) {
	dice[i] = rng:integer(1, 6)
}
print(table.concat(dice, " "))
print(rng:integer(-1000, 1000), rng:integer(-2 ^ 53, -1), rng:integer(0, 2 ^ 53 - 1))
print(rng:uniform(10, 20), rng:uniform(-1, 1), rng:uniform(5, 1))
print(rng:normal(), rng:normal(100, 15), rng:normal(-3))

const words = { "ant", "bee", "cat", "dog", "eel", "fox", "gnu", "hen" }
const picked: string = rng:choice(words)
print(picked, rng:choice(words), rng:choice(words))
const deck = table.clone(words)
rng:shuffle(deck)
print(table.concat(deck, " "))
const hand: { string } = rng:sample(words, 3)
print(table.concat(hand, " "), table.concat(rng:sample(words, 8), " "))
const big: { number } = {}
for (i = 1, 1000) {
	big[i] = i
}
print(table.concat(rng:sample(big, 5), " "))
const rolls: { string } = {}
for (i = 1, 12) {
	table.insert(rolls, rng:weighted({ "common", "rare", "never" }, { 9, 1, 0 }))
}
print(table.concat(rolls, " "))

// The same seed, the same numbers: seed() starts a generator over, and
// generators do not share their state.
const a = random.new(7)
const b = random.new(7)
const first = a:integer(1, 1000000)
random.new(7):random()
print(first == b:integer(1, 1000000), a:random() == b:random())
a:seed(7)
print(a:integer(1, 1000000) == first)

// The module's functions share one generator, which seed() fixes too.
random.seed(7)
print(random.integer(1, 1000000) == first)
random.seed(99)
const shared = { random.random(), random.integer(1, 6), random.uniform(0, 1), random.normal() }
const word = random.choice(words)
const own = random.new(99)
print(shared[1] == own:random(), shared[2] == own:integer(1, 6), shared[3] == own:uniform(0, 1), shared[4] == own:normal(), word == own:choice(words))
const list = { 1, 2, 3, 4, 5 }
random.shuffle(list)
print(#list, #random.sample(list, 2), random.weighted({ true, false }, { 1, 0 }))
random.seed()
print(random.random() >= 0, random.new():random() < 1)

// Edges: a range of one, nothing to draw, no spread.
print(rng:integer(5, 5), rng:integer(2 ^ 53, 2 ^ 53), #rng:sample(words, 0), rng:normal(4, 0), rng:uniform(3, 3))
const none: { number } = {}
rng:shuffle(none)
const one = { "only" }
rng:shuffle(one)
print(#none, one[1], rng:choice(one), rng:weighted(one, { 0.5 }))
print(typeof(rng))

const mistakes: { () -> ...unknown } = {
	function() { rng:integer(6, 1) },
	function() { rng:integer(1, 6.5) },
	function() { rng:integer(0, 2 ^ 53) },
	function() { rng:integer(-2 ^ 54, 0) },
	function() { rng:integer(0, math.huge) },
	function() { rng:uniform(0, 0 / 0) },
	function() { rng:normal(0, -1) },
	function() { rng:choice({}) },
	function() { rng:sample(words, 9) },
	function() { rng:sample(words, -1) },
	function() { rng:weighted(words, { 1, 2 }) },
	function() { rng:weighted({ "a", "b" }, { 1, -1 }) },
	function() { rng:weighted({ "a", "b" }, { 0, 0 }) },
	function() { rng:weighted({ "a", "b" }, { 1e308, 1e308 }) },
	function() { rng:weighted({}, {}) },
	function() { random.seed(1.5) },
	function() { random.new(2 ^ 63) },
}
for (_, mistake in mistakes) {
	const ok, why = pcall(mistake)
	print(ok, string.match(tostring(why), "random%.%w+: .*$"))
}
