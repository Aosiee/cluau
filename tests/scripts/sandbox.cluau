// cluau --sandbox
// The sandbox: no file, network or process access.
const process = require("@std/process")
print(process.args[1], process.platform != "")
print(process.run == nil, process.env == nil, process.spawn == nil, process.chdir == nil)

print(pcall(require, "@std/fs"))
print(pcall(require, "@std/http"))
print(pcall(require, "@std/watch"))
print(pcall(require, "@std/worker")) // it runs files

// Modules from the script's directory load; those outside it do not, and
// one outside that exists reads the same as one that doesn't.
print(require("./lib/greet").Hello("sandbox"))
const outside, outsideWhy = pcall(require, "../check/lib/greet")
const missing, missingWhy = pcall(require, "../check/lib/none")
print(outside, string.gsub(tostring(outsideWhy), "greet", "?") == string.gsub(tostring(missingWhy), "none", "?")) // allow-any: pcall's error values

print(require("@std/json").encode({ ran = true }))
print(require("@std/toml").decode("ran = true").ran)
print(require("@std/uuid").version(require("@std/uuid").v7()), require("@std/semver").satisfies("1.2.3", "^1"))
print(require("@std/yaml").encode(require("@std/yaml").decode("ran: true")))

// @std/log works without an environment to read CLUAU_LOG from.
const log = require("@std/log")
log.configure({ time = false, output = "stdout" })
log.debug("not written")
log.logger("sandbox"):info("logged", { ran = true })

// Async functions and await run on @std/task, which the sandbox keeps.
async function Twice(n: number): number {
	return n * 2
}
print(await Twice(21))
