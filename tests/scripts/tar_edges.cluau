// @std/tar on headers made by hand: a NUL byte in a PAX path, a PAX size
// (for an entry of 8 GiB or more) and a bad one, an old GNU header (times
// where ustar has its prefix), GNU sparse files, negative base-256 numbers,
// a checksum summed as signed bytes, and a writer given a mode out of range.
const tar = require("@std/tar")
const fs = require("@std/fs")
const path = require("@std/path")
const time = require("@std/time")

const dir = path.join(fs.tempDir(), `cluau-tar-edges-{math.floor(time.now() * 1000)}`)
fs.mkdir(dir)

const Pad = function(text: string, width: number): string {
	return string.sub(text, 1, width) .. string.rep("\0", width - math.min(#text, width))
}

type Header = {
	name: string,
	size: number?,
	typeflag: string?,
	mtime: string?,     // the raw 12-byte field
	magic: string?,     // 8 bytes at 257: "ustar\0" .. "00" (POSIX) or "ustar  \0" (GNU)
	tail: string?,      // the 155 bytes at 345 (ustar's prefix; GNU's times and sparse map)
	signed: boolean?,   // the checksum summed as signed bytes
}

// One 512-byte header block.
const Block = function(h: Header): string {
	const mtime = h.mtime or string.format("%011o\0", 1600000000)
	const header = Pad(h.name, 100) .. string.format("%07o\0%07o\0%07o\0%011o\0", 420, 0, 0, h.size or 0) .. mtime .. "        " ..
		(h.typeflag or "0") .. Pad("", 100) .. (h.magic or "ustar\00000") .. Pad("", 80) .. Pad(h.tail or "", 155) .. Pad("", 12)
	let sum = 0
	for (i = 1, 512) {
		const byte = string.byte(header, i)
		sum += if (h.signed && byte >= 128) byte - 256 else byte
	}
	return string.sub(header, 1, 148) .. string.format("%06o\0 ", sum) .. string.sub(header, 157)
}

const Data = function(text: string): string {
	return text .. string.rep("\0", (512 - #text % 512) % 512)
}

// A PAX extended header holding `records` (each "key=value").
const Pax = function(records: { string }): string {
	const parts: { string } = {}
	for (_, record in records) {
		const body = " " .. record .. "\n"
		let length = #body + #tostring(#body)
		length = #body + #tostring(length)
		table.insert(parts, tostring(length) .. body)
	}
	const text = table.concat(parts)
	return Block({ name = "PaxHeader", size = #text, typeflag = "x" }) .. Data(text)
}

const kEnd = string.rep("\0", 1024)

const List = function(label: string, data: string) {
	const ok, archive = pcall(tar.fromString, data)
	if (!ok) {
		print(label, "error", archive)
		return
	}
	for (_, e in archive:entries()) {
		print(label, repr(e.name), e.size, e.modified)
	}
}

// A NUL byte in a PAX path: the name is refused whole, before anything is
// written (each "..\0" would otherwise climb a directory).
const nul = Pax({ "path=..\0/..\0/escaped.txt" }) .. Block({ name = "x", size = 4 }) .. Data("evil") .. kEnd
const inside = path.join(dir, "a", "b", "out")
print(pcall(function() {
	tar.fromString(nul):extract(inside)
}))
print("escaped", fs.exists(path.join(dir, "a", "escaped.txt")), fs.exists(path.join(dir, "escaped.txt")))

// A PAX size: the header says 0 (as for an entry of 8 GiB or more), the
// data and the next header follow the PAX size.
const sized = Pax({ "size=5" }) .. Block({ name = "big.txt", size = 0 }) .. Data("hello") .. Block({ name = "next.txt", size = 3 }) .. Data("abc") .. kEnd
List("pax size", sized)
print("pax size", tar.fromString(sized):read("big.txt"), tar.fromString(sized):read("next.txt"))
// A PAX size past the data, or not a whole number, is an error.
List("pax past", Pax({ "size=100000" }) .. Block({ name = "z.txt", size = 1 }) .. Data("z") .. kEnd)
List("pax nan", Pax({ "size=nan" }) .. Block({ name = "z.txt", size = 0 }) .. kEnd)
// A PAX time is a decimal number (a fraction kept); anything else leaves the header's.
List("pax mtime", Pax({ "mtime=1600000000.5" }) .. Block({ name = "t.txt" }) .. Pax({ "mtime=inf" }) .. Block({ name = "u.txt" }) .. kEnd)

// An old GNU header ("ustar  \0"): offset 345 holds times, not a prefix.
List("old gnu", Block({ name = "./a.txt", magic = "ustar  \0", tail = string.format("%011o\0%011o\0", 1600000001, 1600000002) }) .. kEnd)
// POSIX ustar's prefix is still read.
List("prefix", Block({ name = "file.txt", tail = "some/dir" }) .. kEnd)

// GNU sparse files: listed with their real name and size, refused by read and extract.
const realSize = string.rep("\0", 483 - 345) .. string.format("%011o\0", 5242880)
const gnuSparse = Block({ name = "sparse.bin", size = 512, typeflag = "S", magic = "ustar  \0", tail = realSize }) .. Data("x") ..
	Block({ name = "after.txt", size = 2 }) .. Data("ok") .. kEnd
List("gnu sparse", gnuSparse)
print(pcall(function() {
	tar.fromString(gnuSparse):read("sparse.bin")
}))
print(pcall(function() {
	tar.fromString(gnuSparse):extract(path.join(dir, "sparse"))
}))
const paxSparse = Pax({ "GNU.sparse.major=1", "GNU.sparse.minor=0", "GNU.sparse.name=./sparse.bin", "GNU.sparse.realsize=5242880" }) ..
	Block({ name = "./GNUSparseFile.1/sparse.bin", size = 512 }) .. Data("1\n0\n512\n") .. kEnd
List("pax sparse", paxSparse)

// Base-256: 0x80 starts a positive number, 0xFF a negative one (GNU's time
// before 1970).
const minusDay = "\255" .. string.rep("\255", 8) .. "\254\174\128" // -86400
List("negative", Block({ name = "old.txt", mtime = minusDay }) .. kEnd)
List("positive", Block({ name = "new.txt", mtime = "\128" .. string.rep("\0", 7) .. "\0\0\1\0" }) .. kEnd)

// A checksum some old writers made: the bytes summed as signed.
List("signed sum", Block({ name = "\195\169.txt", signed = true }) .. kEnd)
List("bad sum", string.sub(Block({ name = "x.txt" }), 1, 148) .. "0000001\0" .. string.sub(Block({ name = "x.txt" }), 157) .. kEnd)

// The writer: a mode that a header cannot hold is refused, and the limits are kept.
for (_, mode in { -1, 2 ^ 21, 0 / 0, 1.5 }) {
	print("mode", mode, pcall(function() {
		tar.create():add("f", "x", { mode = mode })
	}))
}
const largest = tar.fromString(tar.create():add("f", "x", { mode = 2 ^ 21 - 1 }):add("g", "y", { mode = 0 }):finish() :: string)
for (_, e in largest:entries()) {
	print("mode kept", e.name, e.mode)
}
print(pcall(function() {
	tar.create():add("a\0b", "x")
}))

fs.remove(dir, true)
