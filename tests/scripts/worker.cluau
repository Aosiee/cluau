// @std/worker: scripts run in parallel, each in a runtime of its own; what
// they send each other is copied.
const json = require("@std/json")
const process = require("@std/process")
const task = require("@std/task")
const worker = require("@std/worker")

print(worker.isWorker, #worker.args)

// Messages both ways, in order; a receive that times out gives nil.
const echo = worker.start("lib/worker/echo", "one", "two")
for (i = 1, 3) {
	echo:send({ n = i, list = { i, i * 2 } })
}
for (i = 1, 3) {
	const reply = echo:receive() :: { n: number, list: { number } }
	print(reply.n, reply.list[2])
}
print(echo:receive(0.01), echo:receive(0), echo.done, typeof(echo))

// The arguments and the results cross by copy: nil, booleans, numbers,
// strings with any bytes, buffers, json.null, tables (keys too), with the
// marks json.object and json.array put on them.
const bytes = buffer.create(3)
buffer.writeu8(bytes, 2, 255)
const record: { [unknown]: unknown } = { name = "a\0b", [true] = 1, [2.5] = "x", missing = json.null, empty = json.array(), none = json.object() }
const a, b, c, d, e, f, notes = worker.start("lib/worker/values", nil, false, -0.5, math.huge, bytes, record):join()
print(a, b, c, d, typeof(e), e != bytes, buffer.readu8(e :: buffer, 2))
const got = f :: { [unknown]: unknown }
print(got.name == "a\0b", got[true], got[2.5], got.missing == json.null, got != record)
print(repr(notes))

// What cannot be sent says where it is.
const Try = function(fn: () -> ()) {
	try {
		fn()
	} catch (error) {
		print(error)
	}
}
Try(function() {
	const handlers: { unknown } = { "a", print }
	echo:send({ handlers = handlers })
})
const cyclic: { [string]: unknown } = {}
cyclic.self = { back = cyclic }
Try(function() {
	echo:send(cyclic)
})
const shared = { 1 }
Try(function() {
	echo:send({ first = shared, second = shared })
})
Try(function() {
	echo:send({ [print] = true })
})
Try(function() {
	echo:send({ ["a key"] = setmetatable({}, {}) })
})
Try(function() {
	echo:send({ w = echo })
})
Try(function() {
	echo:send(nil)
})
Try(function() {
	worker.start("lib/worker/echo", 1, coroutine.create(print))
})
let deep: { unknown } = {}
for (i = 1, 1000) {
	deep = { deep }
}
Try(function() {
	echo:send(deep)
})
Try(function() {
	worker.send(1)
})
Try(function() {
	worker.receive()
})
Try(function() {
	worker.start("lib/worker/missing")
})

// join waits for the end and gives back what the script returned, a
// second join the same again.
echo:send("stop")
print(echo:join())
print(echo:join())
print(echo.done, echo:receive())
echo:send("dropped: the worker has ended")

// An error in the worker is raised by join, with the worker's stack; a
// task's error in the worker too.
print(worker.start("lib/worker/fail", 1):join())
const failing = worker.start("lib/worker/fail", 5)
Try(function() {
	failing:join()
})
Try(function() {
	failing:join()
})
Try(function() {
	worker.start("lib/worker/fail", 7, "task"):join()
})
Try(function() {
	worker.start("lib/worker/refuse", "results"):join()
})
Try(function() {
	worker.start("lib/worker/refuse", "send"):join()
})

// terminate stops a worker at its next safepoint, in a blocking call too;
// what joins it gets nothing. Its `catch` cannot keep it going.
for (_, how in { "compute", "sleep", "wait" }) {
	const busy = worker.start("lib/worker/busy", how)
	print(how, busy:receive())
	busy:terminate()
	print(select("#", busy:join()), busy.done)
	busy:terminate()
}

// process.exit in a worker ends the worker; a status other than 0 is an
// error for join.
print(select("#", worker.start("lib/worker/exit", 0):join()))
Try(function() {
	worker.start("lib/worker/exit", 3):join()
})

// In a task, receive and join wait on their own and the other tasks run;
// the script's own code runs the tasks while it waits.
const ticker = worker.start("lib/worker/echo")
let ticks = 0
const counting = task.spawn(function() {
	while (!ticker.done) {
		task.wait(0.005)
		ticks += 1
	}
})
const relay = task.spawn(function(): unknown {
	const reply = ticker:receive()
	ticker:send("stop")
	return reply
})
process.sleep(0.05) // as long as this: the task's receive waits, not the script
ticker:send("ping")
print(task.join(relay), ticker:join())
task.join(counting)
print(ticks > 0)

// A task cancelled while it waits takes nothing: the message is the next
// receive's.
const later = worker.start("lib/worker/echo")
const waiting = task.spawn(function(): unknown {
	return later:receive()
})
task.cancel(waiting)
later:send("kept")
print(later:receive())
later:send("stop")
print(later:join())

// A worker's tasks are its own: a task of this script waiting on a join
// leaves the worker's task.join free to find that its task can never end.
const never = worker.start("lib/worker/never")
const joining = task.spawn(function(): unknown {
	return never:join()
})
print(task.join(joining))

// Work in parallel: each worker sums a part.
const parts: { worker.Worker } = {}
for (i = 0, 7) {
	table.insert(parts, worker.start("lib/worker/sum", i * 1000000 + 1, (i + 1) * 1000000))
}
let total = 0
for (_, part in parts) {
	total += part:join() :: number
}
print(total == 8000000 * 8000001 / 2)

// A worker's workers are its own.
print(worker.start("lib/worker/nested"):join())
