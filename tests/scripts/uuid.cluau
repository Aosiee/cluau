// @std/uuid: the form, version and variant of the UUIDs it makes (their
// properties, since the UUIDs differ every run), v7 order, parsing in every
// accepted form and refusing malformed text, and RFC 9562's examples.
const uuid = require("@std/uuid")
const time = require("@std/time")

const shape = "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
const variants: { [string]: boolean } = { ["8"] = true, ["9"] = true, a = true, b = true }

function Shaped(id: string, version: string): boolean {
	return #id == 36 && string.find(id, shape) != nil && string.sub(id, 15, 15) == version && variants[string.sub(id, 20, 20)] == true
}

// v4: random, each one different.
const seen: { [string]: boolean } = {}
let v4Shaped = 0
let v4Different = 0
for (i = 1, 20000) {
	const id = uuid.v4()
	if (Shaped(id, "4") && uuid.version(id) == 4 && uuid.time(id) == nil) {
		v4Shaped += 1
	}
	if (!seen[id]) {
		v4Different += 1
		seen[id] = true
	}
}
print("v4:", v4Shaped, "shaped as version 4,", v4Different, "different")

// v7: each after the one before, even in the same millisecond, holding the
// time it was made.
const before = time.now()
let last = uuid.v7()
let v7Shaped = 0
let v7Ordered = 0
for (i = 1, 20000) {
	const id = uuid.v7()
	if (Shaped(id, "7") && uuid.version(id) == 7) {
		v7Shaped += 1
	}
	if (id > last) {
		v7Ordered += 1
	}
	last = id
}
const after = time.now()
const made = uuid.time(last) :: number
print("v7:", v7Shaped, "shaped as version 7,", v7Ordered, "after the one before")
print("v7 time within the run:", made >= math.floor(before * 1000) / 1000 && made <= after)

print(uuid.NIL, uuid.version(uuid.NIL), uuid.isValid(uuid.NIL))
print(uuid.MAX, uuid.version(uuid.MAX), uuid.isValid(uuid.MAX))

// Accepted forms, each giving the canonical lowercase one.
for (_, text in {
	"0f8fad5b-d9cb-469f-a165-70867728950e",
	"0F8FAD5B-D9CB-469F-A165-70867728950E",
	"0f8FaD5b-D9cB-469f-A165-70867728950e",
	"{0F8FAD5B-D9CB-469F-A165-70867728950E}",
	"urn:uuid:0f8fad5b-d9cb-469f-a165-70867728950e",
	"URN:UUID:0F8FAD5B-D9CB-469F-A165-70867728950E",
}) {
	print(text, "->", uuid.parse(text), uuid.isValid(text))
}

// Malformed text.
for (_, text in {
	"",
	"0f8fad5b-d9cb-469f-a165-70867728950",
	"0f8fad5b-d9cb-469f-a165-70867728950e0",
	"0f8fad5bd9cb469fa16570867728950e",
	"0f8fad5b-d9cb-469f-a16570867728950e",
	"0f8fad5-bd9cb-469f-a165-70867728950e",
	"0f8fad5b-d9cb-469f-a165-70867728950g",
	"0f8fad5b_d9cb_469f_a165_70867728950e",
	"+f8fad5b-d9cb-469f-a165-70867728950e",
	" 0f8fad5b-d9cb-469f-a165-70867728950e",
	"0f8fad5b-d9cb-469f-a165-70867728950e ",
	"0f8fad5b-d9cb-469f-a165-70867728950e\n",
	"{0f8fad5b-d9cb-469f-a165-70867728950e",
	"0f8fad5b-d9cb-469f-a165-70867728950e}",
	"{{0f8fad5b-d9cb-469f-a165-70867728950e}}",
	"(0f8fad5b-d9cb-469f-a165-70867728950e)",
	"uuid:0f8fad5b-d9cb-469f-a165-70867728950e",
	"urn:0f8fad5b-d9cb-469f-a165-70867728950e",
	"urn:uuid:{0f8fad5b-d9cb-469f-a165-70867728950e}",
	"{urn:uuid:0f8fad5b-d9cb-469f-a165-70867728950e}",
	"urn:uuid:0f8fad5b-d9cb-469f-a165-70867728950",
	"０f8fad5b-d9cb-469f-a165-70867728950e",
	"0f8fad5b-d9cb-469f-a165-70867728950e0f8fad5b-d9cb-469f-a165-70867728950e",
}) {
	print(repr(text), uuid.parse(text), uuid.isValid(text), uuid.version(text), uuid.time(text))
}

// RFC 9562's examples (appendix A and B): each version, and the time the
// time-based ones hold (2022-02-22 19:22:22 UTC).
for (_, text in {
	"C232AB00-9414-11EC-B3C8-9F6BDECED846",
	"5df41881-3aed-3515-88a7-2f4a814cf09e",
	"919108f7-52d1-4320-9bac-f847db4148a8",
	"2ed6657d-e927-568b-95e1-2665a8aea6a2",
	"1EC9414C-232A-6B00-B3C8-9F6BDECED846",
	"017F22E2-79B0-7CC3-98C4-DC0C0C07398F",
	"2489E9AD-2EE2-8E00-8EC9-32D5F69181C0",
	"320C3D4D-CC00-875B-8EC9-32D5F69181C0",
	// Another variant (110x, Microsoft's), where the bits are not a version.
	"0f8fad5b-d9cb-469f-c165-70867728950e",
}) {
	const t = uuid.time(text)
	print(uuid.parse(text), uuid.version(text), if (t == nil) "no time" else time.iso(t, { utc = true }))
}

print(pcall(uuid.parse, (5 :: unknown) :: string))
