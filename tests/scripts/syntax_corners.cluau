// Statements after x++, a type or `...`; class defaults on their lines;
// try with continued returns, varargs and an `error` local.

// A line after x++, an optional type, a generic or `...` starts a statement.
let n = 1
n++
if (n > 1) {
	print("after ++", n)
}
let best: string?
if (best == nil) {
	print("after ?")
}
type Box<T> = { value: T }
type Numbers = Box<number>
if (true) {
	print("after >")
}
n--
{
	print("block after --", n)
}
function Varargs(...: number): number {
	let first = ...
	if (first) {
		print("after ...", first)
	}
	try {
		print("try sees", ...)
	} catch (e) {
		print("never", e)
	}
	try {
		throw "x"
	} catch (e) {
		print("catch sees", select("#", ...))
	}
	return first
}
print(Varargs(4, 5))

// A return in a try takes the lines that continue it.
function Sum(): number {
	try {
		return 1
			+ 2
	} catch (e) {
		print("never", e)
	}
	return 0
}
function Pick(a: boolean): string {
	try {
		return if (a) "yes"
			else "no"
	} catch (e) {
		print("never", e)
	}
	return ""
}
print(Sum(), Pick(true), Pick(false))

// A local named `error` does not change what throw raises.
function Shadow(error: string): string {
	try {
		throw error .. "!"
	} catch (e) {
		return `caught {e}`
	}
	return ""
}
print(Shadow("bad"))

// Field defaults keep their text and their lines; a static's function.
class Corner {
	S: string = "a    b"
	L: string = [[x
y]]
	Items: {number} = {
		1, // one
		2,
	}
	Cb: () -> number = function(): number { return 3 }
	static Make = function(k: number): number { return k * 2 }

	function Line(): number {
		return debug.info(1, "l") // allow-any: debug.info is untyped; the line shows the class kept its lines
	}
}
let c = Corner()
print(c.S, c.L, #c.Items, c.Cb(), Corner.Make(4), c:Line())

//[[ a line comment, not a long one
print("after //[[")
/* see t[1]*/ print("after ]")
print(`nested {`inner {n != 1 && true}`}`)

// A comment right after a minus is a comment, not part of the operator.
let m = 5
m = m -/* one */1
print("m", m, 10 -// and the rest on the next line
	3)

// An interpolation segment is an expression like any other: functions,
// comments, glued `!`, long strings, if-expressions and `~/`.
let items = { 3, 1, 2 }
print(`sorted: {(function(): string { table.sort(items); return table.concat(items, ",") })()}`)
print(`{m /* the count */ + 1} {true and!false} {string.len([==[a`b]==])} {if (m > 1) "big" else "small"} {7 ~/ 2}`)

// In a try, the `...` a segment uses, and a return's value on the next line.
function Count(...: number): string {
	try {
		return `{select("#", ...)} arguments`
	} catch (e) {
		return "failed"
	}
}
function Later(): number {
	try {
		return
		42
	} catch (e) {
		return 0
	}
}
function Table(): {number} {
	try {
		return
		{ 1, 2 }
	} catch (e) {
		return {}
	}
}
print(Count(1, 2, 3), Later(), #Table())
