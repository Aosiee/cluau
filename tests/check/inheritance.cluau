// Subclass errors cluau check reports.
const Vehicle = require("./lib/vehicle")

class Animal {
	Name: string = "?"
	static Kingdom = "animalia"

	function Init(name: string) {
		self.Name = name
	}

	function Speak(): string {
		return "..."
	}
}

class Bird extends Animal {
	Wings: number = 2

	function Init(name: string, wings: number) {
		super:Init(name)
		self.Wings = wings
	}
}

class Dog extends Animal {
}

const pip = Bird("Pip", 2)
const named: string = pip.Name     // inherited fields and methods type-check
const said: string = pip:Speak()
print(named, said)

const rex = Dog(42)                 // Dog inherits Animal's constructor
const wings: string = pip.Wings     // the subclass's own field keeps its type
pip:Fly()                           // neither class has Fly
const animal: Animal = pip          // a subclass is its base
const bird: Bird = Animal("Generic") // a base is not a subclass

// Statics are read through instances too.
const kingdom: string = pip.Kingdom
const notANumber: number = pip.Kingdom

// A subclass of another module's class that declares no Init: a warning,
// its constructor's arguments are not checked.
class Bike extends Vehicle {
}
class Car extends Vehicle {
	function Init(doors: number) {
		super:Init(4)
	}
}
print(kingdom, Bike(2), Car(4))
