# Writes OUT: a C++ file holding the standard modules written in cluau
# (src/runtime/std/<name>.cluau) as text, for the runtime to load on their
# first require and for the checker to type them from.
#   cmake -DOUT=<file.cpp> -DDIR=<src/runtime/std> -P embed_std.cmake
file(GLOB sources ${DIR}/*.cluau)
list(SORT sources)
set(code "// Generated by cmake/embed_std.cmake from src/runtime/std/*.cluau.\n#include <map>\n#include <string>\n\nnamespace cluau::runtime::detail {\n\n\tconst std::map<std::string, std::string>& StdSources()\n\t{\n\t\tstatic const std::map<std::string, std::string> sources = {\n")
foreach(source ${sources})
    get_filename_component(name ${source} NAME_WE)
    file(READ ${source} text)
    # A function a module declares at its top level (`function Name(...)`)
    # is the module's own: each is declared a local on the first line, so
    # that the declaration assigns that local rather than a global the
    # script and the other modules would see (and could replace), while the
    # module's functions can still call those declared after them.
    string(REGEX MATCHALL "(^|\n)function [A-Za-z_][A-Za-z0-9_]*[ \t]*[<(]" declared "${text}")
    set(names "")
    foreach(match ${declared})
        string(REGEX REPLACE "^\n?function ([A-Za-z_][A-Za-z0-9_]*).*" "\\1" fn "${match}")
        list(APPEND names ${fn})
    endforeach()
    list(REMOVE_DUPLICATES names)
    if(names)
        list(JOIN names ", " joined)
        set(text "local ${joined}; ${text}")
    endif()
    string(LENGTH "${text}" length)
    set(pieces "")
    set(at 0)
    # Pieces under the length some compilers allow one string literal.
    while(at LESS length)
        string(SUBSTRING "${text}" ${at} 4000 piece)
        string(APPEND pieces "\t\t\t\tR\"CLUAU_STD(${piece})CLUAU_STD\"\n")
        math(EXPR at "${at} + 4000")
    endwhile()
    if(pieces STREQUAL "")
        set(pieces "\t\t\t\t\"\"\n")
    endif()
    # Adjacent literals join into one string.
    string(APPEND code "\t\t\t{ \"${name}\",\n${pieces}\t\t\t},\n")
endforeach()
string(APPEND code "\t\t};\n\t\treturn sources;\n\t}\n\n} // namespace cluau::runtime::detail\n")
file(WRITE ${OUT}.new "${code}")
file(COPY_FILE ${OUT}.new ${OUT} ONLY_IF_DIFFERENT)
